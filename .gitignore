# ============================================================================
# Odoo 19 外贸 SOHO 进销存自研模块
#
# 本目录即 Odoo 的 addons_path，一个模块一个一级目录。
# 这里只忽略「运行/开发过程中产生的」文件，模块源码与文档必须入库。
# ============================================================================


# ----------------------------------------------------------------------------
# Python / Odoo 运行时产物
# Odoo 部署后会直接在模块目录生成 __pycache__，不忽略会持续污染 diff
# ----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
sdist/
wheels/
*.egg-info/
*.egg
MANIFEST

# Odoo 模块升级残留（升级脚本执行后可能留下）
*.pot.bak
*.po~


# ----------------------------------------------------------------------------
# 虚拟环境与依赖目录
# ----------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
.python-version


# ----------------------------------------------------------------------------
# 测试与覆盖率
# ----------------------------------------------------------------------------
.tox/
.nox/
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
nosetests.xml


# ----------------------------------------------------------------------------
# 类型检查 / 静态分析缓存
# ----------------------------------------------------------------------------
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pyre/
.pytype/


# ----------------------------------------------------------------------------
# 日志与数据库
# Odoo 日志、dump、sqlite 都可能含业务数据，绝不入库
# ----------------------------------------------------------------------------
*.log
*.log.*
logs/
odoo.log
*.sql
*.sql.gz
*.dump
*.sqlite
*.sqlite3
*.db


# ----------------------------------------------------------------------------
# 前端构建产物与依赖
# 本仓库目前模块无前端构建流程（静态资源直接以源码形式由 Odoo 资产打包），
# 后续若引入打包工具（如为某模块加 esbuild/vite），取消对应注释即可
# ----------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.bower-cache/
.sass-cache/
.cache/
.parcel-cache/
.temp/
.tmp/


# ----------------------------------------------------------------------------
# 环境与本地配置
# 含数据库口令、addons_path 等环境信息，严禁入库
# ----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.conf
!.conf.example
*.cfg.local
odoo.conf.local


# ----------------------------------------------------------------------------
# 操作系统生成文件
# ----------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
Icon

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*


# ----------------------------------------------------------------------------
# 编辑器与 IDE
# 团队 IDE 不统一，个人配置各自忽略；共享配置（如 .vscode/extensions.json）需显式放行
# ----------------------------------------------------------------------------
.idea/
*.iml
*.iws
*.ipr
out/

.vscode/*
!.vscode/extensions.json
!.vscode/settings.default.json
!.vscode/launch.default.json
!.vscode/tasks.default.json

*.swp
*.swo
*.swn
*~
.tags
.tags_sorted_by_file
.session.vim

*.sublime-project
*.sublime-workspace

.project
.pydevproject
.settings/

# Cursor / AI 编辑器本地状态
# 注意：.codebuddy/ 存放项目级配置与数据，不忽略
.cursor/mcp.json
.trae/
.history/


# ----------------------------------------------------------------------------
# 备份与临时文件
# 迁移自本地备份目录的模块会留下 .bak/.orig 等，确认无误后删除，不入库
# ----------------------------------------------------------------------------
*.bak
*.orig
*.rej
*.tmp
*.sw?
*.patch
*.diff
