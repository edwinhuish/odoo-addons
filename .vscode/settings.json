{
  // Odoo 源码在本仓库的上一级（AGENTS.md 的 ../odoo 约定），给 Pylance 用于跳转/补全
  "python.analysis.extraPaths": ["${workspaceFolder}/../odoo"],
  "python.testing.unittestEnabled": false,
  "python.testing.pytestEnabled": false,
  "terminal.integrated.defaultProfile.linux": "bash",
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    ".dev/backups": true
  },
  "search.exclude": {
    "**/__pycache__": true,
    ".dev/backups": true
  },
  "files.watcherExclude": {
    "**/__pycache__/**": true,
    "**/.dev/backups/**": true
  },
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "[python]": { "editor.formatOnSave": false },
  "[xml]": { "editor.formatOnSave": false },
  "files.trimTrailingWhitespace": false
}
