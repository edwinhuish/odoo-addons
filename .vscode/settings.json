{
  // Odoo 核心源码在 odoo 容器里（AGENTS.md 第 2 节），仓库不再另存一份 ../odoo。
  // 要在编辑器里跳转/补全，先跑 `task odoo-src`：它把镜像里的核心 .py 导到 .dev/.cache/odoo-src。
  // 目录不存在也不报错，只是没有核心源码的补全。
  "python.analysis.extraPaths": ["${workspaceFolder}/.dev/.cache/odoo-src"],
  "python.testing.unittestEnabled": false,
  "python.testing.pytestEnabled": false,
  "terminal.integrated.defaultProfile.linux": "bash",
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    ".dev/backups": true,
    // 导出的核心源码（上万文件）：不在文件树里展开，省得 VS Code 一直索引
    ".dev/.cache": true
  },
  "search.exclude": {
    "**/__pycache__": true,
    ".dev/backups": true,
    ".dev/.cache": true
  },
  "files.watcherExclude": {
    "**/__pycache__/**": true,
    "**/.dev/backups/**": true,
    "**/.dev/.cache/**": true
  },
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "[python]": { "editor.formatOnSave": false },
  "[xml]": { "editor.formatOnSave": false },
  "files.trimTrailingWhitespace": false
}
