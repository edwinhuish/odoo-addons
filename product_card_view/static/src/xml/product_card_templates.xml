<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!--
      渲染器模板：对 web.KanbanRenderer 做 primary 继承副本，仅给根容器
      追加 o_product_card_view 类，其余结构与行为完全沿用 kanban（分组、翻页、空态等）。
    -->
    <t t-name="product_card_view.ProductCardRenderer"
        t-inherit="web.KanbanRenderer"
        t-inherit-mode="primary">
        <xpath expr="//div[hasclass('o_kanban_renderer')]" position="attributes">
            <attribute name="class">o_kanban_renderer o_renderer d-flex user-select-none o_product_card_view</attribute>
        </xpath>
    </t>

    <!--
      产品卡片本体：
      布局：顶部图片轮播（箭头 + 计数 + 滑动），主体 title / reference / on hand，
      多变体产品底部按属性分行渲染变体按钮。交互区统一加 o_product_card__stop 防止误打开产品。

      关键：变体按钮的 class 用 t-attf-class（模板字符串，primitive）而非 t-att-class 对象
      表达式——对象每次构造新引用，Owl 对 t-att-class 对象引用敏感会触发重渲染循环。
    -->
    <t t-name="product_card_view.Card">
        <article class="o_kanban_record o_product_card d-flex flex-column overflow-hidden"
            t-att-tabindex="0"
            t-on-click="onCardClick"
            t-on-keydown="onCardKeyDown"
            t-att-title="title">
            <!-- 顶部图片轮播 -->
            <div class="o_product_card__imgbox position-relative"
                t-on-pointerdown="onImagePointerDown"
                t-on-pointerup="onImagePointerUp"
                t-on-pointerleave="onImagePointerCancel"
                t-on-pointercancel="onImagePointerCancel">
                <div class="o_product_card__track d-flex"
                    t-att-style="`transform: translateX(${-100 * activeImageIndex}%)`">
                    <t t-foreach="images" t-as="image" t-key="`${image.model}-${image.id}`">
                        <div class="o_product_card__slide flex-shrink-0">
                            <img class="o_product_card__img"
                                t-att-src="imageSrc(image)"
                                t-att-alt="imageAlt()"
                                loading="lazy"
                                draggable="false" />
                        </div>
                    </t>
                </div>
                <t t-if="imageCount > 1">
                    <button type="button"
                        class="btn btn-link o_product_card__arrow o_product_card__arrow_left o_product_card__stop"
                        t-att-aria-label="arrowTitle('previous')"
                        t-on-click.stop="previousImage">
                        <i class="fa fa-chevron-left" aria-hidden="true" />
                    </button>
                    <button type="button"
                        class="btn btn-link o_product_card__arrow o_product_card__arrow_right o_product_card__stop"
                        t-att-aria-label="arrowTitle('next')"
                        t-on-click.stop="nextImage">
                        <i class="fa fa-chevron-right" aria-hidden="true" />
                    </button>
                    <span class="o_product_card__counter o_product_card__stop">
                        <t t-esc="activeImageIndex + 1" /> / <t t-esc="imageCount" />
                    </span>
                </t>
            </div>

            <!-- 主体信息 -->
            <div class="o_product_card__body d-flex flex-column flex-grow-1">
                <div class="o_product_card__title text-truncate" t-att-title="title">
                    <t t-esc="title" />
                </div>
                <div t-if="selectionText" class="o_product_card__selection text-truncate">
                    <t t-esc="selectionText" />
                </div>
                <div class="o_product_card__meta d-flex align-items-center justify-content-between">
                    <span class="o_product_card__reference text-truncate"
                        t-att-title="referenceLabel">
                        <t t-esc="referenceText" />
                    </span>
                    <span class="o_product_card__stock badge"
                        t-att-title="onHandLabel"
                        t-att-aria-label="onHandLabel">
                        <t t-esc="onHandText" />
                    </span>
                </div>
            </div>

            <!-- 变体按钮行（一属性一行） -->
            <t t-if="rows.length">
                <div class="o_product_card__variants o_product_card__stop">
                    <t t-foreach="rows" t-as="row" t-key="row.attr_id">
                        <div class="o_product_card__row d-flex align-items-start">
                            <span class="o_product_card__attr text-nowrap" t-att-title="row.attr_name">
                                <t t-esc="row.attr_name" />
                            </span>
                        </div>
                    </t>
                </div>
            </t>
        </article>
    </t>

</templates>
