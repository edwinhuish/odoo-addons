<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
      卡片视图本体：type=card。arch 根 <card>，<field name="name"/> 供卡片
      渲染读取；具体卡片 UI 由 product_card_renderer 自绘（payload 驱动）。
    -->
    <record id="product_template_card_view" model="ir.ui.view">
        <field name="name">product.template.card</field>
        <field name="model">product.template</field>
        <field name="type">card</field>
        <field name="arch" type="xml">
            <card records_draggable="0" quick_create="false">
                <field name="name"/>
            </card>
        </field>
    </record>

    <!-- 扩展官方 Products 动作：view_mode 加 card（视图切换器出现 Card 按钮） -->
    <record id="product.product_template_action" model="ir.actions.act_window">
        <field name="view_mode">kanban,list,card,form</field>
    </record>

    <!-- 将 card view 绑定到动作（view_mode=card，sequence 插 list 与 form 之间） -->
    <record id="product_template_action_card_view" model="ir.actions.act_window.view">
        <field name="act_window_id" ref="product.product_template_action"/>
        <field name="view_id" ref="product_template_card_view"/>
        <field name="view_mode">card</field>
        <field name="sequence" eval="3"/>
    </record>

</odoo>
