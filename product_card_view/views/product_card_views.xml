<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
      卡片视图本体：type=card。arch 根 <card>，<field name="name"/> 供卡片
      渲染读取；具体卡片 UI 由 product_card_renderer 自绘（payload 驱动）。
    -->
    <record id="product_template_card_view" model="ir.ui.view">
        <field name="name">product.template.card</field>
        <field name="model">product.template</field>
        <field name="type">card</field>
        <field name="arch" type="xml">
            <card records_draggable="0" quick_create="false">
                <field name="name"/>
            </card>
        </field>
    </record>

    <!--
      同一 model（product.template）在 Odoo 多个模块各定义了 act_window：
        - product.product_template_action          (Sales / 主 Products 菜单)
        - product.product_template_action_all      (Inventory > Products 内的 "All")
        - stock.product_template_action_product    (Inventory > Products 入口)
      必须都扩展 view_mode 并各加一条 act_window.view 记录
      （_unique_mode_per_action = (act_window_id, view_mode)）。
    -->

    <!-- 1) product.product_template_action -->
    <record id="product.product_template_action" model="ir.actions.act_window">
        <field name="view_mode">kanban,list,card,form</field>
    </record>
    <record id="product_template_action_card_view" model="ir.actions.act_window.view">
        <field name="act_window_id" ref="product.product_template_action"/>
        <field name="view_id" ref="product_template_card_view"/>
        <field name="view_mode">card</field>
        <!-- sequence=0：原生视图行的 sequence 是 NULL，升序里 NULL 排最后，
             非 NULL 的 card 因此在 views 里排第一 → 列表默认打开卡片视图 -->
        <field name="sequence" eval="0"/>
    </record>

    <!-- 2) product.product_template_action_all -->
    <record id="product.product_template_action_all" model="ir.actions.act_window">
        <field name="view_mode">kanban,list,card,form</field>
    </record>
    <record id="product_template_action_all_card_view" model="ir.actions.act_window.view">
        <field name="act_window_id" ref="product.product_template_action_all"/>
        <field name="view_id" ref="product_template_card_view"/>
        <field name="view_mode">card</field>
        <!-- sequence=0：原生视图行的 sequence 是 NULL，升序里 NULL 排最后，
             非 NULL 的 card 因此在 views 里排第一 → 列表默认打开卡片视图 -->
        <field name="sequence" eval="0"/>
    </record>

    <!-- 3) stock.product_template_action_product（Inventory > Products 入口） -->
    <record id="stock.product_template_action_product" model="ir.actions.act_window">
        <field name="view_mode">kanban,list,card,form</field>
    </record>
    <record id="product_template_action_product_card_view" model="ir.actions.act_window.view">
        <field name="act_window_id" ref="stock.product_template_action_product"/>
        <field name="view_id" ref="product_template_card_view"/>
        <field name="view_mode">card</field>
        <!-- sequence=0：原生视图行的 sequence 是 NULL，升序里 NULL 排最后，
             非 NULL 的 card 因此在 views 里排第一 → 列表默认打开卡片视图 -->
        <field name="sequence" eval="0"/>
    </record>

    <!--
      4) sale / purchase / account 等由可选模块提供的产品动作，不需要在这里声明任何记录：
      它们由 Python 侧 `ir.actions.act_window._compute_views()` 的覆盖统一注入 card
      （见 models/product_card.py），因此与安装顺序无关，全新安装也不会漏。
    -->

</odoo>
