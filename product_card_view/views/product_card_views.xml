<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
      卡片视图（view type=card，arch 用 <card>，复用 kanban ArchParser/Controller/search）。
      ir.ui.view.type 的 'card' 选项由 models/product_card.py 扩展 Selection 提供。
      不再有独立动作 / 菜单——Card 按钮直接加到官方 Products 视图切换器。
    -->
    <record id="product_card_view_card" model="ir.ui.view">
        <field name="name">product.template.product.card.view</field>
        <field name="model">product.template</field>
        <field name="type">card</field>
        <field name="arch" type="xml">
            <card records_draggable="0" quick_create="false">
                <field name="name"/>
            </card>
        </field>
    </record>

    <!--
      扩展官方产品 action：view_mode 加 card（在 kanban 左侧），
      view_ids 加 card view。Inventory / Sales / Purchase 的 Products 菜单
      用的就是这两个 action，故 Card 按钮在所有 Products 页面都出现。
    -->
    <record id="product.product_template_action" model="ir.actions.act_window">
        <field name="view_mode">card,kanban,list,form</field>
    </record>
    <record id="product_template_action_card_view" model="ir.actions.act_window.view">
        <field name="act_window_id" ref="product.product_template_action"/>
        <field name="sequence" eval="1"/>
        <field name="view_mode">card</field>
        <field name="view_id" ref="product_card_view_card"/>
    </record>

    <record id="product.product_template_action_all" model="ir.actions.act_window">
        <field name="view_mode">card,kanban,list,form</field>
    </record>
    <record id="product_template_action_all_card_view" model="ir.actions.act_window.view">
        <field name="act_window_id" ref="product.product_template_action_all"/>
        <field name="sequence" eval="1"/>
        <field name="view_mode">card</field>
        <field name="view_id" ref="product_card_view_card"/>
    </record>

</odoo>
