<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- 产品表单：在原生 Logistics 组的 Volume 之前插入「尺寸单位 + 尺寸」。 -->
    <!-- 这两组字段在模板上只是单变体桥接，真实数据在变体上；可见性沿用原生 -->
    <!-- volume / weight 的规则：产品有多条变体时在模板表单上隐藏，改到变体 -->
    <!-- 表单里逐条维护。                                                 -->
    <!-- 变量名 is_product_variant / product_variant_count 都来自原生视图。 -->
    <!-- ============================================================ -->
    <record id="product_template_form_inherit_dimension" model="ir.ui.view">
        <field name="name">product.template.form.inherit.dimension</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//label[@for='volume']" position="before">
                <label for="dimension_unit" string="Dimension Unit"
                       invisible="product_variant_count &gt; 1 and not is_product_variant"/>
                <div class="o_row" name="dimension_unit"
                     invisible="product_variant_count &gt; 1 and not is_product_variant">
                    <field name="dimension_unit" class="oe_inline" style="max-width: 7rem;"/>
                </div>

                <label for="dimension_length" string="Dimensions"
                       invisible="product_variant_count &gt; 1 and not is_product_variant"/>
                <div class="o_row" name="dimension_dimensions"
                     invisible="product_variant_count &gt; 1 and not is_product_variant">
                    <field name="dimension_length" placeholder="L" class="oe_inline" style="max-width: 6rem;"/>
                    <span class="oe_inline">x</span>
                    <field name="dimension_width" placeholder="W" class="oe_inline" style="max-width: 6rem;"/>
                    <span class="oe_inline">x</span>
                    <field name="dimension_height" placeholder="H" class="oe_inline" style="max-width: 6rem;"/>
                </div>
            </xpath>

        </field>
    </record>

</odoo>
