#. module: product_image
#: model_terms:ir.actions.act_window,help:product_image.action_product_image_gallery
msgid ""
"Product images are managed as a gallery of additional images. Several images "
"can coexist and be reordered by dragging. The main image is managed "
"separately and is not maintained here."
msgstr ""
"产品图片以图库形式管理补充图，支持多图并存、拖拽排序；主图独立，不在此维护。"

#. module: product_image
#: model:ir.actions.act_window,name:product_image.action_product_image_gallery
#: model_terms:ir.ui.view,arch_db:product_image.product_image_gallery_list_view
#: model_terms:ir.ui.view,arch_db:product_image.product_image_gallery_search_view
msgid "Product Images"
msgstr "产品图片"

#. module: product_image
#: model_terms:ir.actions.act_window,help:product_image.action_product_image_gallery
msgid "Add a product image"
msgstr "添加一张产品图片"

#. module: product_image
#: model_terms:ir.ui.view,arch_db:product_image.product_image_gallery_list_view
msgid "Image"
msgstr "图片"

#. module: product_image
#: model_terms:ir.ui.view,arch_db:product_image.product_image_gallery_form_view
msgid "Optional, e.g. Front / Detail / Packaging"
msgstr "可选，如 正面 / 细节 / 包装"

#. module: product_image
#: model_terms:ir.ui.view,arch_db:product_image.product_image_gallery_form_view
msgid ""
"Click to select an image file, or press Ctrl+V in the gallery area to paste "
"a new one"
msgstr "点击选择图片文件，或在图库区域 Ctrl+V 粘贴新增"

#. module: product_image
#: model_terms:ir.ui.view,arch_db:product_image.product_image_gallery_search_view
