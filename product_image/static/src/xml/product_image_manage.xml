<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <!--
        图片管理弹窗：编辑态点击「+」（缩略图列末尾占位符）后弹出。
        - 上半部分：左侧大图预览（跟随弹窗内选中项）+ 右侧平铺缩略图网格；
          · 布局：大图列宽固定（大图盒 250×250），名称单行截断（固定行高）+
            提示固定行高 → 切换任意图片（含有无图片）时弹窗尺寸不变；缩略图网格
            占满除大图列与间距外的全部宽高（超高内部滚动，图片多少也不改变高度）
          · 大图仅用于预览（无删除按钮）；大图名称行：选中主图时留空不显示“主图”
          · 缩略图拖动排序：主图固定首位不参与，拖动时其余缩略图平滑避让，
            松手落位后写回图库 sequence（保存产品时一并生效）
          · 删除入口在缩略图网格（×）与 header「批量删除」；任何删除都有确认框
            （带图片缩略图；主图删除提示图库首张自动提升）
        - 下半部分：图片 dropzone（点击选择 / 拖放 / Ctrl+V），自实现文件选择；
          每张上传中的图片立即显示本地缩略图 + 转圈动画，完成后自动移除并入网格；
          Ctrl+V 粘贴上传完成后不自动关闭弹窗
        - 关闭按钮：modal-header 最右侧正方形按钮（无文字、占满 header 高度，hover 变红）
        - 列表 / 数据通过 props（getItems/onDelete/onReorder/onUploaded 绑定到 gallery widget）
          与后台记录保持同步；本弹窗作为顶层 overlay，避免 record.update 重渲染
          gallery 时波及弹窗（粘贴上传闪烁）
    -->
    <t t-name="product_image.ProductImageManageDialog">
        <div class="o_product_image_manage modal d-block show"
             tabindex="0"
             t-ref="autofocus"
             t-on-keydown.stop="(ev) => this.onKeydown(ev)"
             t-on-paste="onPaste"
             t-on-click.self="close">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header align-items-center">
                        <h5 class="modal-title mb-0">图片管理</h5>
                        <!-- header 右侧操作区：批量删除 / 勾选态操作 + 关闭按钮 -->
                        <div class="d-flex align-items-center gap-1 pe-1">
                            <template t-if="state.selectMode">
                                <span class="small text-muted o_gm_selcount"
                                      t-att-class="checkedCount ? 'o_gm_selcount-on' : ''">
                                    已选 <t t-esc="checkedCount"/> 张
                                </span>
                                <button type="button"
                                        class="btn btn-sm btn-danger d-inline-flex align-items-center gap-1"
                                        t-att-disabled="checkedCount == 0"
                                        t-on-click="requestBatchDelete"
                                        title="删除所选图片">
                                    <i class="fa fa-trash"/>
                                    删除
                                </button>
                                <button type="button"
                                        class="btn btn-sm btn-link"
                                        t-on-click="_exitSelectMode">
                                    取消
                                </button>
                            </template>
                            <button t-elif="items.length > 1"
                                    type="button"
                                    class="o_gm_headerbtn btn btn-sm btn-light d-inline-flex align-items-center gap-1"
                                    t-on-click="enterSelectMode"
                                    title="勾选多张图片后批量删除">
                                <i class="fa fa-check-square-o"/>
                                批量删除
                            </button>
                            <!-- 关闭按钮：右上角、正方形、无文字、占满 header 高，hover 变红 -->
                            <button type="button"
                                    class="o_gallery_manage-close"
                                    t-on-click="close"
                                    aria-label="关闭"
                                    title="关闭 (Esc)">
                                <i class="fa fa-times"/>
                            </button>
                        </div>
                    </div>

                    <div class="modal-body">
                        <!-- ============ 上半部分：大图 + 平铺缩略图 ============ -->
                        <div class="o_gallery_manage-top d-flex gap-3 align-items-stretch">

                            <!-- 大图预览（弹窗内选中项；仅作预览，不提供删除按钮）。
                                 固定布局：列宽固定 250 + 大图盒 250×250 + 名称单行截断
                                 （固定行高）+ 提示固定行高 → 切换任意图片本列尺寸恒定。
                                 选中主图时名称行留空（不显示“主图”），行高仍占位 -->
                            <div class="o_gallery_manage-preview d-flex flex-column">
                                <div class="o_gallery_manage-previewbox position-relative d-flex align-items-center justify-content-center">
                                    <img t-if="currentItem"
                                         loading="lazy"
                                         class="img img-fluid"
                                         t-att-src="currentItem.bigUrl"
                                         t-att-alt="currentName"
                                         draggable="false"/>
                                    <div t-if="!currentItem"
                                         class="text-muted small text-center px-2">
                                        暂无图片
                                    </div>
                                </div>
                                <div class="o_gallery_manage-name text-muted small text-center mt-1 text-truncate">
                                    <span t-if="showName" t-esc="currentName"/>
                                    <span t-if="!showName">&nbsp;</span>
                                </div>
                                <div class="o_gallery_manage-hint text-muted text-center mt-1">
                                    拖动缩略图可排序；删除均有确认（批量删除在右上角）
                                </div>
                            </div>

                            <!-- 平铺缩略图网格：占满预览列之外的剩余全部宽高；每张缩略图
                                 （含主图）右上角 ×；超高内部滚动，不参与行高计算。
                                 拖动排序 / 勾选模式下网格切为绝对定位 + transform 布局 -->
                            <div class="o_gallery_manage-thumbs flex-fill d-flex flex-column">
                                <div class="o_gallery_manage-grid"
                                     t-ref="grid"
                                     t-att-class="state.drag ? ' is-sorting' : ''">
                                    <t t-if="items.length">
                                        <t t-foreach="items" t-as="it" t-key="it.key">
                                            <div class="o_gallery_manage-tile position-relative"
                                                 t-att-class="tileClasses(it_index)"
                                                 t-att-style="tileStyle(it_index)"
                                                 t-on-click="(ev) => this.onTileClick(it_index, ev)"
                                                 t-on-pointerdown="(ev) => this.onSortPointerDown(it_index, ev)">
                                                <img loading="lazy"
                                                     class="img"
                                                     t-att-src="it.thumbUrl"
                                                     t-att-alt="it.name"
                                                     t-att-title="it.name"
                                                     draggable="false"/>
                                                <!-- 批量勾选态：左上角勾选圈（主图也可勾选删除） -->
                                                <div t-if="state.selectMode"
                                                     class="o_gallery_manage-check">
                                                    <i t-if="state.checkedKeys.includes(it.key)"
                                                       class="fa fa-check"/>
                                                </div>
                                                <!-- 正常态：右上角 × 删除（先确认） -->
                                                <button t-if="!state.selectMode"
                                                        type="button"
                                                        class="o_gallery_manage-del"
                                                        t-on-click.stop="() => this.requestDelete(it_index)"
                                                        t-att-aria-label="'删除' + it.name"
                                                        title="删除该图片">
                                                    <i class="fa fa-times"/>
                                                </button>
                                            </div>
                                        </t>
                                        <!-- 拖动排序时撑高网格内容（absolute 布局下保底可滚动） -->
                                        <div t-if="state.drag"
                                             class="o_gallery_manage-sort-spacer"
                                             t-att-style="'height:' + state.drag.spacerH + 'px'"/>
                                    </t>
                                    <div t-if="!items.length" class="text-muted small w-100">
                                        暂无图片，请在下方上传。
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 分割线：上半部（管理）与下半部（上传） -->
                        <div class="o_gallery_manage-divider d-flex align-items-center gap-2 my-3">
                            <hr class="flex-fill m-0"/>
                            <span class="small text-muted text-nowrap">
                                <i class="fa fa-cloud-upload me-1"/>
                                新增图片
                            </span>
                            <hr class="flex-fill m-0"/>
                        </div>

                        <!-- ============ 下半部分：上传 dropzone + 上传队列 ============ -->
                        <div class="o_gallery_manage-bottom">
                            <div class="o_manage_dropzone d-flex flex-column align-items-center justify-content-center text-center"
                                 t-on-click="openPicker"
                                 t-att-class="state.dragging ? 'is-dragging' : ''"
                                 t-on-dragover.prevent="onDragOver"
                                 t-on-dragleave.prevent="onDragLeave"
                                 t-on-drop.prevent="onDrop">
                                <i class="fa fa-cloud-upload fa-3x mb-2"/>
                                <p class="mb-1 fw-bold">点击选择文件，或将图片拖放到此处</p>
                                <p class="small text-muted mb-0">
                                    或按 <kbd>Ctrl</kbd>+<kbd>V</kbd> 粘贴剪贴板图片
                                </p>
                            </div>
                            <input type="file"
                                   t-ref="fileInput"
                                   t-att-accept="props.acceptedFileExtensions or 'image/*'"
                                   multiple="true"
                                   class="d-none"
                                   t-on-change="onFileInputChange"/>
                            <!-- 上传队列：每张上传中的图片显示缩略图 + 对应转圈动画 -->
                            <div class="o_gallery_manage-queue" t-if="state.queue.length">
                                <t t-foreach="state.queue" t-as="up" t-key="up.key">
                                    <div class="o_gallery_manage-upload">
                                        <img t-att-src="up.objectUrl"
                                             t-att-alt="up.name"
                                             t-att-title="up.name"
                                             draggable="false"/>
                                        <div class="o_gallery_manage-uploading">
                                            <i class="fa fa-spinner fa-spin"/>
                                            <span>上传中…</span>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ============ 删除确认框（覆盖在弹窗之上；带图片缩略图清单） ============ -->
            <div t-if="state.confirm"
                 class="o_gallery_manage-confirm-overlay"
                 t-on-click.self="cancelConfirm">
                <div class="o_gallery_manage-confirm">
                    <div class="o_gallery_manage-confirm-head">
                        <span class="o_gallery_manage-confirm-title">
                            <i class="fa fa-exclamation-triangle me-2"/>
                            <t t-esc="state.confirm.title"/>
                        </span>
                        <button type="button"
                                class="o_gallery_manage-confirm-x"
                                t-on-click="cancelConfirm"
                                aria-label="关闭">
                            <i class="fa fa-times"/>
                        </button>
                    </div>
                    <div class="o_gallery_manage-confirm-body">
                        <p class="o_gallery_manage-confirm-msg mb-0">
                            <t t-esc="state.confirm.message"/>
                        </p>
                        <div class="o_gallery_manage-confirm-thumbs">
                            <t t-foreach="state.confirm.items" t-as="ci" t-key="ci.key">
                                <div class="o_gallery_manage-confirm-thumb"
                                     t-att-title="ci.name">
                                    <img t-att-src="ci.thumbUrl"
                                         t-att-alt="ci.name"
                                         draggable="false"/>
                                    <span t-if="ci.type === 'main'"
                                          class="o_gallery_manage-confirm-tag">主图</span>
                                </div>
                            </t>
                        </div>
                    </div>
                    <div class="o_gallery_manage-confirm-foot">
                        <button type="button"
                                class="btn btn-sm btn-secondary"
                                t-on-click="cancelConfirm">
                            取消
                        </button>
                        <button type="button"
                                class="btn btn-sm btn-danger"
                                t-on-click="confirmDelete">
                            <i class="fa fa-trash me-1"/>
                            <t t-esc="state.confirm.confirmLabel"/>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </t>

</templates>
