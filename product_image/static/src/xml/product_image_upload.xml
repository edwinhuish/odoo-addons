<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <!-- 产品图片上传弹窗：点击 / 拖放 / Ctrl+V 三种上传方式 -->
    <t t-name="product_image.ProductImageUploadDialog">
        <div class="o_product_image_upload modal d-block show"
             tabindex="0"
             t-ref="autofocus"
             t-on-keydown.stop="(ev) => this.onKeydown(ev)"
             t-on-paste="onPaste"
             t-on-click.self="close">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header align-items-center">
                        <h5 class="modal-title">新增图片</h5>
                        <button type="button"
                                class="o_upload_close btn btn-light border-0"
                                t-on-click="close"
                                aria-label="关闭"
                                title="关闭 (Esc)">
                            <i class="fa fa-times fa-lg"/>
                        </button>
                    </div>
                    <div class="modal-body">
                        <!-- 拖放区域同时作为 FileUploader 的 toggler：点击唤起文件选择 -->
                        <FileUploader acceptedFileExtensions="props.acceptedFileExtensions"
                                      onUploaded.bind="onUploaderFileUploaded"
                                      multiUpload="true">
                            <t t-set-slot="toggler">
                                <div class="o_upload_dropzone d-flex flex-column align-items-center justify-content-center text-center"
                                     t-att-class="state.dragging ? 'is-dragging' : ''"
                                     t-on-dragover.prevent="onDragOver"
                                     t-on-dragleave.prevent="onDragLeave"
                                     t-on-drop.prevent="onDrop">
                                    <i class="fa fa-cloud-upload fa-3x mb-2"/>
                                    <p class="mb-1 fw-bold">点击选择文件，或将图片拖放到此处</p>
                                    <p class="small text-muted mb-0">
                                        或在弹窗打开时按 <kbd>Ctrl</kbd>+<kbd>V</kbd> 粘贴剪贴板图片
                                    </p>
                                </div>
                            </t>
                        </FileUploader>
                        <div t-if="state.processing" class="text-center mt-3 small text-muted">
                            <i class="fa fa-spinner fa-spin"/> 处理中…
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>

</templates>
