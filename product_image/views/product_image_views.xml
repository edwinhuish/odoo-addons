<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- 产品图片：独立列表视图                                       -->
    <!-- ============================================================ -->
    <record id="product_image_gallery_list_view" model="ir.ui.view">
        <field name="name">product.image.gallery.list</field>
        <field name="model">product.image.gallery</field>
        <field name="arch" type="xml">
            <list string="产品图片">
                <field name="sequence" widget="handle"/>
                <field name="image_128" widget="image" string="图片"
                       options="{'zoom': True}"/>
                <field name="name"/>
                <field name="product_tmpl_id"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
                <field name="note" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- 产品图片：独立表单视图                                       -->
    <!-- ============================================================ -->
    <record id="product_image_gallery_form_view" model="ir.ui.view">
        <field name="name">product.image.gallery.form</field>
        <field name="model">product.image.gallery</field>
        <field name="arch" type="xml">
            <form string="产品图片">
                <sheet>
                    <group>
                        <group>
                            <field name="product_tmpl_id"
                                   options="{'no_create': True}"/>
                            <field name="name" placeholder="可选，如 正面 / 细节 / 包装"/>
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="note"/>
                        </group>
                        <group>
                            <field name="image_1920" widget="image"
                                   options="{'convert_to_webp': True, 'preview_image': 'image_128', 'zoom': True}"
                                   nolabel="1"
                                   help="点击选择图片文件，或在图库区域 Ctrl+V 粘贴新增"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- 产品图片：独立搜索视图                                       -->
    <!-- ============================================================ -->
    <record id="product_image_gallery_search_view" model="ir.ui.view">
        <field name="name">product.image.gallery.search</field>
        <field name="model">product.image.gallery</field>
        <field name="arch" type="xml">
            <search string="产品图片">
                <field name="name"/>
                <field name="product_tmpl_id"/>
                <field name="note"/>
                <filter name="filter_active" string="启用"
                        domain="[('active', '=', True)]"/>
                <filter name="filter_inactive" string="停用"
                        domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- 产品图片：菜单动作                                           -->
    <!-- ============================================================ -->
    <record id="action_product_image_gallery" model="ir.actions.act_window">
        <field name="name">产品图片</field>
        <field name="res_model">product.image.gallery</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="product_image_gallery_search_view"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                添加一张产品图片
            </p>
            <p>
                产品图片以图库形式管理补充图，支持多图并存、拖拽排序；主图独立，不在此维护。
            </p>
        </field>
    </record>

</odoo>
