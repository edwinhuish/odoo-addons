<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- 产品图片：独立列表视图                                       -->
    <!-- ============================================================ -->
    <record id="product_image_gallery_list_view" model="ir.ui.view">
        <field name="name">product.image.gallery.list</field>
        <field name="model">product.image.gallery</field>
        <field name="arch" type="xml">
            <list string="Product Images">
                <field name="sequence" widget="handle"/>
                <field name="image_128" widget="image" string="Image"
                       options="{'zoom': True}"/>
                <field name="name"/>
                <field name="product_tmpl_id"/>
                <field name="product_id" optional="show"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
                <field name="note" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- 产品图片：独立表单视图                                       -->
    <!-- ============================================================ -->
    <record id="product_image_gallery_form_view" model="ir.ui.view">
        <field name="name">product.image.gallery.form</field>
        <field name="model">product.image.gallery</field>
        <field name="arch" type="xml">
            <form string="Product Image">
                <sheet>
                    <group>
                        <group>
                            <field name="product_tmpl_id"
                                   options="{'no_create': True}"/>
                            <field name="product_id"
                                   options="{'no_create': True}"/>
                            <field name="name" placeholder="Optional, e.g. Front / Detail / Packaging"/>
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="note"/>
                        </group>
                        <group>
                            <field name="image_1920" widget="image"
                                   options="{'convert_to_webp': True, 'preview_image': 'image_128', 'zoom': True}"
                                   nolabel="1"
                                   help="Click to select an image file, or press Ctrl+V in the gallery area to paste a new one"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- 产品图片：独立搜索视图                                       -->
    <!-- ============================================================ -->
    <record id="product_image_gallery_search_view" model="ir.ui.view">
        <field name="name">product.image.gallery.search</field>
        <field name="model">product.image.gallery</field>
        <field name="arch" type="xml">
            <search string="Product Images">
                <field name="name"/>
                <field name="product_tmpl_id"/>
                <field name="product_id"/>
                <field name="note"/>
                <filter name="filter_active" string="Active"
                        domain="[('active', '=', True)]"/>
                <filter name="filter_inactive" string="Archived"
                        domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- 产品图片：菜单动作                                           -->
    <!-- ============================================================ -->
    <record id="action_product_image_gallery" model="ir.actions.act_window">
        <field name="name">Product Images</field>
        <field name="res_model">product.image.gallery</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="product_image_gallery_search_view"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a product image
            </p>
            <p>Product images are managed as a gallery of additional images. Several images can coexist and be reordered by dragging. The main image is managed separately and is not maintained here.</p>
        </field>
    </record>

</odoo>
