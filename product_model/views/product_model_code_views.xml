<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- 型号明细模型：独立列表/表单视图（便于管理员单独检索与维护）   -->
    <!-- ============================================================ -->

    <record id="product_model_code_list_view" model="ir.ui.view">
        <field name="name">product.model.code.list</field>
        <field name="model">product.model.code</field>
        <field name="arch" type="xml">
            <list string="Product Models" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="model_code" required="1"/>
                <field name="model_type"/>
                <field name="product_tmpl_id" readonly="1"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="product_model_code_form_view" model="ir.ui.view">
        <field name="name">product.model.code.form</field>
        <field name="model">product.model.code</field>
        <field name="arch" type="xml">
            <form string="Product Model">
                <sheet>
                    <group>
                        <group>
                            <field name="model_code" required="1"
                                   placeholder="e.g. MODEL-A, SKU-1234"/>
                            <field name="model_type"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="product_tmpl_id"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <group>
                        <field name="note"
                               placeholder="Optional, e.g. customer / version / effective date"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="product_model_code_search_view" model="ir.ui.view">
        <field name="name">product.model.code.search</field>
        <field name="model">product.model.code</field>
        <field name="arch" type="xml">
            <search string="Product Models">
                <field name="model_code"/>
                <field name="model_type"/>
                <field name="product_tmpl_id"/>
                <separator/>
                <filter string="Active" name="active"
                        domain="[('active', '=', True)]"/>
                <filter string="Archived" name="inactive"
                        domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_product_model_code" model="ir.actions.act_window">
        <field name="name">Product Models</field>
        <field name="res_model">product.model.code</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="product_model_code_search_view"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a product model
            </p>
            <p>A product can carry several models (customer / factory / alias). They are usually maintained on the "Models" page of the product form; this view is meant for bulk search and maintenance.</p>
        </field>
    </record>

</odoo>
