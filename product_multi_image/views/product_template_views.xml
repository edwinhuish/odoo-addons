<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- 产品表单视图：在「常规信息」页之后新增「图库」页               -->
    <!-- 继承基础视图 product.product_template_form_view，对其所有      -->
    <!-- primary 子视图（如 product_template_only_form_view）同步生效    -->
    <!-- ============================================================ -->
    <record id="product_template_form_inherit" model="ir.ui.view">
        <field name="name">product.template.form.inherit.image.gallery</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//page[@name='general_information']" position="after">
                <page string="图库" name="image_gallery">
                    <field name="image_gallery_ids" widget="one2many">
                        <list string="图片图库" editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="image_1920" widget="image"
                                   options="{'convert_to_webp': True, 'preview_image': 'image_128', 'zoom': True}"
                                   nolabel="1" string="图片"
                                   help="点击选择图片文件，或在图库区域 Ctrl+V 粘贴新增"/>
                            <field name="is_main" widget="boolean_toggle" readonly="1"/>
                            <field name="name" placeholder="可选，如 正面 / 细节 / 包装"/>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="note" placeholder="可选，对该图片的补充说明"/>
                        </list>
                    </field>
                    <p class="text-muted small oe_edit_only">
                        提示：拖拽「排序」列可调整顺序；首图（排序最前）自动作为产品主图。
                        在图库区域按 Ctrl+V 可直接粘贴剪贴板图片新增一条记录（需 image_uploader 模块）。
                    </p>
                </page>
            </xpath>

        </field>
    </record>

    <!-- ============================================================ -->
    <!-- 产品列表视图：新增「图片数量」列（可选显示）                   -->
    <!-- ============================================================ -->
    <record id="product_template_list_inherit" model="ir.ui.view">
        <field name="name">product.template.list.inherit.image.gallery</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='default_code']" position="after">
                <field name="image_gallery_count" string="图片数"
                       optional="hide"
                       readonly="1"/>
            </xpath>

        </field>
    </record>

    <!-- ============================================================ -->
    <!-- 产品看板视图：原生已展示 image_128（即主图缩略），无需改动      -->
    <!-- 主图由首图自动同步到 product.template.image_1920/128          -->
    <!-- ============================================================ -->

</odoo>
