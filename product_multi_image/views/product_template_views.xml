<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- 产品表单视图：把原生头像区域的 image_1920 字段改为多图 widget -->
    <!-- 同一位置切换/浏览多张图片，不新增页签，保持界面简洁          -->
    <!-- ============================================================ -->
    <record id="product_template_form_inherit" model="ir.ui.view">
        <field name="name">product.template.form.inherit.image.gallery</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">

            <!-- 替换原生头像图片字段的 widget 为多图图库 widget -->
            <xpath expr="//field[@name='image_1920'][hasclass('oe_avatar')]" position="attributes">
                <attribute name="widget">product_image_gallery</attribute>
            </xpath>

            <!-- 声明图库 One2many 字段（不可见），为 widget 提供字段元数据上下文 -->
            <!-- 不声明则新建图库记录时 activeFields/fields 为空，update 报错 -->
            <xpath expr="//field[@name='image_1920'][hasclass('oe_avatar')]" position="after">
                <field name="image_gallery_ids" invisible="1">
                    <!-- 内嵌 list 视图：声明需要参与新建/读取的字段，保证 activeFields 含 image_1920 等 -->
                    <list editable="bottom">
                        <field name="sequence" widget="handle"/>
                        <field name="image_1920" widget="image"
                               options="{'convert_to_webp': True, 'preview_image': 'image_128', 'zoom': True}"/>
                        <field name="name"/>
                        <field name="is_main" readonly="1"/>
                        <field name="active"/>
                        <field name="note"/>
                    </list>
                </field>
            </xpath>

        </field>
    </record>

    <!-- ============================================================ -->
    <!-- 产品列表视图：新增「图片数量」列（可选显示）                   -->
    <!-- ============================================================ -->
    <record id="product_template_list_inherit" model="ir.ui.view">
        <field name="name">product.template.list.inherit.image.gallery</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='default_code']" position="after">
                <field name="image_gallery_count" string="图片数"
                       optional="hide"
                       readonly="1"/>
            </xpath>

        </field>
    </record>

</odoo>
