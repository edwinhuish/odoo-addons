#. module: product_reference
#: model_terms:ir.actions.act_window,help:product_reference.action_product_reference_code
msgid "Create a product reference"
msgstr "创建一条产品参考号"

#. module: product_reference
#: model_terms:ir.actions.act_window,help:product_reference.action_product_reference_code
msgid ""
"A product can carry several references (customer / factory / alias), in "
"addition to the standard Odoo Reference. They are usually maintained with the "
"\"+\" button next to the Reference field of the product form; this view is "
"meant for bulk search and maintenance."
msgstr ""
"一个产品除标准 Odoo Reference 外，还可挂多条参考号（客户参考号 / 工厂参考号 / 别名）。通常在产品表单 Reference 字段右侧的「+」按钮中维护，此处用于批量检索与维护。"

#. module: product_reference
#: model:ir.actions.act_window,name:product_reference.action_product_reference_code
#: model_terms:ir.ui.view,arch_db:product_reference.product_reference_code_list_view
#: model_terms:ir.ui.view,arch_db:product_reference.product_reference_code_search_view
msgid "Product References"
msgstr "产品参考号"

#. module: product_reference
#: model:ir.model,name:product_reference.model_product_reference_code
#: model_terms:ir.ui.view,arch_db:product_reference.product_reference_code_form_view
#: code:addons/product_reference/static/src/js/product_reference_editor.js:0
msgid "Product Reference"
msgstr "产品参考号"

#. module: product_reference
#: model_terms:ir.ui.view,arch_db:product_reference.product_reference_code_form_view
#: model_terms:ir.ui.view,arch_db:product_reference.product_template_form_inherit
#: model_terms:ir.ui.view,arch_db:product_reference.product_variant_easy_form_inherit
#: model_terms:ir.ui.view,arch_db:product_reference.product_normal_form_view_inherit
#: code:addons/product_reference/static/src/xml/product_reference_manage.xml:0
msgid "e.g. REF-A, SKU-1234"
msgstr "如 REF-A、SKU-1234"

#. module: product_reference
#: model_terms:ir.ui.view,arch_db:product_reference.product_reference_code_search_view
#: model:ir.model.fields,field_description:product_reference.field_product_reference_code__active
#: code:addons/product_reference/static/src/xml/product_reference_manage.xml:0
msgid "Active"
msgstr "启用"

#. module: product_reference
#: model_terms:ir.ui.view,arch_db:product_reference.product_reference_code_search_view
msgid "Archived"
msgstr "停用"

#. module: product_reference
#: model:ir.model.fields,field_description:product_reference.field_product_template__reference_code_line_ids
msgid "Reference Lines"
msgstr "参考号明细"

#. module: product_reference
#: model_terms:ir.ui.view,arch_db:product_reference.product_template_list_inherit
#: model_terms:ir.ui.view,arch_db:product_reference.product_template_search_inherit
#: model:ir.model.fields,field_description:product_reference.field_product_reference_code__reference_code
#: code:addons/product_reference/static/src/xml/product_reference_manage.xml:0
msgid "Reference"
msgstr "参考号"

#. module: product_reference
#: model:ir.model.fields,help:product_reference.field_product_reference_code__reference_code
msgid ""
"Reference code of the product. It cannot be repeated inside the same product, "
"but the same code may be used by other products; when a search hits a "
"reference, the result shows \"Product (Matching reference: xxx)\" to tell them "
"apart."
msgstr ""
"产品参考号，同一产品内不可重复；不同产品间可重复，搜索时命中会显示「产品名（命中参考号：xxx）」以区分。"

#. module: product_reference
#: model:ir.model.fields,field_description:product_reference.field_product_reference_code__reference_type
msgid "Reference Type"
msgstr "参考号类型"

#. module: product_reference
#: model:ir.model.fields.selection,name:product_reference.selection__product_reference_code__reference_type__customer
#: code:addons/product_reference/static/src/js/product_reference_manage.js:0
msgid "Customer Reference"
msgstr "客户参考号"

#. module: product_reference
#: model:ir.model.fields.selection,name:product_reference.selection__product_reference_code__reference_type__factory
#: code:addons/product_reference/static/src/js/product_reference_manage.js:0
msgid "Factory Reference"
msgstr "工厂参考号"

#. module: product_reference
#: model:ir.model.fields.selection,name:product_reference.selection__product_reference_code__reference_type__alias
#: code:addons/product_reference/static/src/js/product_reference_manage.js:0
msgid "Alias"
msgstr "别名"

#. module: product_reference
#: model:ir.model.fields,help:product_reference.field_product_reference_code__reference_type
msgid ""
"Purpose of this reference: customer references are used on outgoing documents, "
"factory references for purchasing, aliases for historical or colloquial names."
msgstr "区分该参考号的用途：客户参考号用于对外单据，工厂参考号用于采购，别名用于历史/俗称匹配。"

#. module: product_reference
#: model:ir.model.fields,field_description:product_reference.field_product_reference_code__sequence
msgid "Sequence"
msgstr "排序"

#. module: product_reference
#: model:ir.model.fields,help:product_reference.field_product_reference_code__sequence
msgid ""
"Lower values come first; both the list and the One2many lines are ordered by "
"this value."
msgstr "数值小的排在前面，列表与 One2many 行均按此排序。"

#. module: product_reference
#: model:ir.model.fields,help:product_reference.field_product_reference_code__active
msgid ""
"Uncheck to disable a reference without deleting it, so history is kept."
msgstr "取消勾选可停用某条参考号而不删除，便于保留历史。"

#. module: product_reference
#: model:ir.model.fields,field_description:product_reference.field_product_reference_code__note
#: code:addons/product_reference/static/src/xml/product_reference_manage.xml:0
msgid "Note"
msgstr "备注"

#. module: product_reference
#: model:ir.model.fields,help:product_reference.field_product_reference_code__note
msgid ""
"Short description of this reference (customer, version, effective date, ...)."
msgstr "对该参考号的简短说明（如对应客户、版本、生效日期等）。"

#. module: product_reference
#: model:ir.model.fields,field_description:product_reference.field_product_reference_code__product_tmpl_id
msgid "Product"
msgstr "产品"

#. module: product_reference
#: model:ir.model.fields,help:product_reference.field_product_reference_code__product_tmpl_id
msgid ""
"Product (shared references) this reference belongs to. Either this field or "
"'Product Variant' must be set: shared references are maintained on the "
"product form and are removed together with the product."
msgstr ""
"该参考号所属的产品（共享参考号）。本字段与「产品变体」二选一：共享参考号在产品表单维护，"
"删除产品时参考号行随之级联清理。"

#. module: product_reference
#: model:ir.model.fields,help:product_reference.field_product_template__reference_code_line_ids
msgid "All references of this product (customer / factory / alias)."
msgstr "该产品的所有参考号（客户参考号 / 工厂参考号 / 别名）。"

#. module: product_reference
#: model:ir.model.fields,field_description:product_reference.field_product_template__reference_code_count
msgid "Reference Count"
msgstr "参考号数量"

#. module: product_reference
#: model:ir.model.fields,field_description:product_reference.field_product_template__reference_code_index
msgid "Reference Search Index"
msgstr "参考号搜索索引"

#. module: product_reference
#: model:ir.model.fields,help:product_reference.field_product_template__reference_code_index
msgid ""
"Search index built by concatenating all references of this product. It is "
"maintained automatically when reference lines change; do not edit it manually."
msgstr "该产品所有参考号拼接后的搜索索引，由参考号行增删改时自动维护，请勿手工编辑。"

#. module: product_reference
#: model:ir.model.constraint,message:product_reference.constraint_reference_code_unique_per_template
msgid "Reference codes must be unique within the same product."
msgstr "同一产品内参考号不可重复。"

#. module: product_reference
#. odoo-python
#: code:addons/product_reference/models/product_reference_code.py:0
msgid ""
"The reference \"%(code)s\" already exists for product \"%(product)s\". Reference "
"codes must be unique within the same product."
msgstr "参考号“%(code)s”在产品“%(product)s”中已存在，同一产品内参考号不可重复。"

#. module: product_reference
#. odoo-python
#: code:addons/product_reference/models/product_template.py:0
msgid " (Matching reference: %(codes)s)"
msgstr "（命中参考号：%(codes)s）"

#. module: product_reference
#. module: product_reference
# 输入框前的标签：中英界面统一显示 Ref.，不做本地化翻译
#: model_terms:ir.ui.view,arch_db:product_reference.product_template_form_inherit
#: model_terms:ir.ui.view,arch_db:product_reference.product_variant_easy_form_inherit
#: model_terms:ir.ui.view,arch_db:product_reference.product_normal_form_view_inherit
msgid "Ref."
msgstr "Ref."

#. module: product_reference
#. odoo-javascript
#: code:addons/product_reference/static/src/js/product_reference_manage.js:0
msgid "The reference could not be added."
msgstr "参考号新增失败。"

#. module: product_reference
#. odoo-javascript
#: code:addons/product_reference/static/src/js/product_reference_manage.js:0
msgid "The reference could not be updated."
msgstr "参考号修改失败。"

#. module: product_reference
#. odoo-javascript
#: code:addons/product_reference/static/src/js/product_reference_manage.js:0
msgid "The reference could not be deleted."
msgstr "参考号删除失败。"

#. module: product_reference
#. odoo-javascript
#: code:addons/product_reference/static/src/js/product_reference_manage.js:0
msgid "The references could not be reordered."
msgstr "参考号排序失败。"

#. module: product_reference
#: code:addons/product_reference/static/src/xml/product_reference_editor.xml:0
msgid "Additional references"
msgstr "额外参考号"

#. module: product_reference
#: code:addons/product_reference/static/src/xml/product_reference_manage.xml:0
msgid "Additional References"
msgstr "额外参考号"

#. module: product_reference
#: code:addons/product_reference/static/src/xml/product_reference_manage.xml:0
msgid ""
"These references are saved together with the product; searching a product by "
"any of them finds this product."
msgstr "这些参考号随产品一起保存；按其中任一参考号搜索均可命中本产品。"

#. module: product_reference
#: code:addons/product_reference/static/src/xml/product_reference_manage.xml:0
msgid "Type"
msgstr "类型"

#. module: product_reference
#: code:addons/product_reference/static/src/xml/product_reference_manage.xml:0
#: code:addons/product_reference/static/src/js/product_reference_editor.js:0
msgid "Add a reference"
msgstr "新增一条参考号"

#. module: product_reference
#: code:addons/product_reference/static/src/xml/product_reference_manage.xml:0
msgid "No additional reference yet."
msgstr "还没有额外参考号。"

#. module: product_reference
#: code:addons/product_reference/static/src/xml/product_reference_manage.xml:0
msgid "Optional, e.g. customer / version / effective date"
msgstr "选填，如对应客户 / 版本 / 生效日期等"

#. module: product_reference
#: code:addons/product_reference/static/src/xml/product_reference_manage.xml:0
msgid "Move up"
msgstr "上移"

#. module: product_reference
#: code:addons/product_reference/static/src/xml/product_reference_manage.xml:0
msgid "Move down"
msgstr "下移"

#. module: product_reference
#: code:addons/product_reference/static/src/xml/product_reference_manage.xml:0
msgid "Delete"
msgstr "删除"

#. module: product_reference
#: code:addons/product_reference/static/src/xml/product_reference_manage.xml:0
msgid "Done"
msgstr "完成"

#. module: product_reference
#: code:addons/product_reference/static/src/xml/product_reference_manage.xml:0
msgid "Close"
msgstr "关闭"

#. module: product_reference
#: model:ir.model.fields,field_description:product_reference.field_product_reference_code__product_id
msgid "Product Variant"
msgstr "产品变体"

#. module: product_reference
#: model:ir.model.fields,help:product_reference.field_product_reference_code__product_id
msgid ""
"Product variant this reference belongs to (variant references, independent "
"from the shared product references). Either this field or 'Product' must be "
"set; the reference is removed together with the variant."
msgstr ""
"该参考号所属的产品变体（变体参考号，与产品共享参考号相互独立）。本字段与「产品」二选一；"
"删除变体时参考号行随之级联清理。"

#. module: product_reference
#: model:ir.model.fields,field_description:product_reference.field_product_product__variant_reference_code_line_ids
msgid "Variant Reference Lines"
msgstr "变体参考号明细"

#. module: product_reference
#: model:ir.model.fields,help:product_reference.field_product_product__variant_reference_code_line_ids
msgid ""
"References specific to this variant (customer / factory / alias). They are "
"independent from the shared product references maintained on the product "
"form: a product with several variants does not share its references between "
"variants."
msgstr ""
"本变体专属的参考号（客户参考号 / 工厂参考号 / 别名），与产品表单维护的共享参考号相互独立："
"有多个变体的产品，参考号不在变体之间共用。"

#. module: product_reference
#: model:ir.model.fields,field_description:product_reference.field_product_product__variant_reference_code_index
msgid "Variant Reference Search Index"
msgstr "变体参考号搜索索引"

#. module: product_reference
#: model:ir.model.fields,help:product_reference.field_product_product__variant_reference_code_index
msgid ""
"Search index built by concatenating the references of this variant. It is "
"maintained automatically when variant reference lines change; do not edit it "
"manually."
msgstr "本变体所有参考号拼接后的搜索索引，由变体参考号行增删改时自动维护，请勿手工编辑。"

#. module: product_reference
#: model:ir.model.constraint,message:product_reference.constraint_reference_code_unique_per_variant
msgid "Reference codes must be unique within the same product variant."
msgstr "同一产品变体内参考号不可重复。"

#. module: product_reference
#. odoo-python
#: code:addons/product_reference/models/product_reference_code.py:0
msgid ""
"A reference must belong either to a product (shared references) or to a "
"product variant (variant references)."
msgstr "一条参考号必须归属产品（共享参考号）或产品变体（变体参考号）之一。"

#. module: product_reference
#. odoo-python
#: code:addons/product_reference/models/product_reference_code.py:0
msgid ""
"A reference cannot belong to both a product and a product variant: choose "
"either the shared product references or the variant references."
msgstr "一条参考号不能同时归属产品与产品变体：请选择共享参考号或变体参考号之一。"
