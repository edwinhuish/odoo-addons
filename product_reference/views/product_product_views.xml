<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- 变体编辑表单（product.product.view.form.easy）：              -->
    <!-- 产品名称下方同样放置原生 Reference 输入框 + 「+」管理弹窗     -->
    <!-- 额外参考号挂在本变体上（variant_reference_code_line_ids），     -->
    <!-- 与产品模板表单维护的产品级共享行相互独立（多变体不共用）        -->
    <!-- ============================================================ -->
    <record id="product_variant_easy_form_inherit" model="ir.ui.view">
        <field name="name">product.product.easy.form.inherit.reference.code</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_variant_easy_edit_view"/>
        <field name="arch" type="xml">

            <!-- 产品名称下方：Reference 编辑器（原生 default_code + 额外参考号入口） -->
            <xpath expr="//div[hasclass('oe_title')]/h1" position="after">
                <div name="product_reference" class="o_product_reference_area mt-1">
                    <!-- 标签固定为 Ref.（中文界面同样显示 Ref.，不做本地化翻译） -->
                    <label for="default_code" string="Ref."/>
                    <!-- lines_field：变体表单维护的是「变体专属」参考号行，
                         与产品模板表单的共享行相互独立（多变体产品参考号不共用） -->
                    <field name="default_code"
                           widget="product_reference_editor"
                           nolabel="1"
                           placeholder="e.g. REF-A, SKU-1234"
                           options="{'lines_field': 'variant_reference_code_line_ids'}"/>
                    <!-- 变体参考号 One2many（不可见）：提供新建行所需的子字段元数据 -->
                    <field name="variant_reference_code_line_ids" invisible="1">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="reference_code"/>
                            <field name="reference_type"/>
                            <field name="active"/>
                            <field name="note"/>
                        </list>
                    </field>
                </div>
            </xpath>

            <!-- Codes 组里的原生 Reference 已移到标题区，隐藏避免重复 -->
            <xpath expr="//group[@name='codes']/field[@name='default_code']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

        </field>
    </record>

    <!-- ============================================================ -->
    <!-- 变体主表单（product.product.form，继承模板基础视图）：        -->
    <!-- 标题区放「变体级」Reference 编辑器（本变体自己的编号 + 本变体 -->
    <!-- 专属参考号行）；常规信息页分类栏里的原生 Reference 隐藏避免   -->
    <!-- 重复。                                                        -->
    <!-- ⚠ 产品级那块（product_template_views.xml 挂在模板表单 h1 后的  -->
    <!-- div）会随继承链一起出现在这个表单上，它带 `invisible=           -->
    <!-- "is_product_variant"`，变体表单上恒为真 → 被隐藏；因此标题区   -->
    <!-- 只剩下面这一个编辑器。改动任一侧（去掉门控 / 再挂一块）都会让  -->
    <!-- 界面上出现两个 Ref. 输入框。                                   -->
    <!-- ============================================================ -->
    <record id="product_normal_form_view_inherit" model="ir.ui.view">
        <field name="name">product.product.form.inherit.reference.code</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//div[hasclass('oe_title')]/h1" position="after">
                <div name="product_reference" class="o_product_reference_area mt-1">
                    <!-- 标签固定为 Ref.（中文界面同样显示 Ref.，不做本地化翻译） -->
                    <label for="default_code" string="Ref."/>
                    <!-- lines_field：主变体表单维护的必须是「本变体专属」的参考号行，
                         与产品表单的共享行互不干扰（多变体不共用）。早期漏写这个 option 时
                         它默认落到继承来的 reference_code_line_ids（产品级共享行）上，
                         于是多变体产品的每个变体都在编辑同一组共享参考号。 -->
                    <field name="default_code"
                           widget="product_reference_editor"
                           nolabel="1"
                           placeholder="e.g. REF-A, SKU-1234"
                           options="{'lines_field': 'variant_reference_code_line_ids'}"/>
                    <field name="variant_reference_code_line_ids" invisible="1">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="reference_code"/>
                            <field name="reference_type"/>
                            <field name="active"/>
                            <field name="note"/>
                        </list>
                    </field>
                </div>
            </xpath>

            <xpath expr="//group[@name='group_standard_price']/field[@name='default_code']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

        </field>
    </record>

</odoo>
