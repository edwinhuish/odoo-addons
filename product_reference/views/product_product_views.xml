<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- 变体编辑表单（product.product.view.form.easy）：              -->
    <!-- 产品名称下方同样放置原生 Reference 输入框 + 「+」管理弹窗     -->
    <!-- 额外参考号挂在其产品模板上（reference_code_line_ids 经         -->
    <!-- _inherits 委托读取），与产品模板表单维护的是同一组行           -->
    <!-- ============================================================ -->
    <record id="product_variant_easy_form_inherit" model="ir.ui.view">
        <field name="name">product.product.easy.form.inherit.reference.code</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_variant_easy_edit_view"/>
        <field name="arch" type="xml">

            <!-- 产品名称下方：Reference 编辑器（原生 default_code + 额外参考号入口） -->
            <xpath expr="//div[hasclass('oe_title')]/h1" position="after">
                <div name="product_reference" class="o_product_reference_area mt-1">
                    <!-- 标签固定为 Ref.（中文界面同样显示 Ref.，不做本地化翻译） -->
                    <label for="default_code" string="Ref."/>
                    <field name="default_code"
                           widget="product_reference_editor"
                           nolabel="1"
                           placeholder="e.g. REF-A, SKU-1234"/>
                    <!-- 额外参考号 One2many（不可见）：提供新建行所需的子字段元数据 -->
                    <field name="reference_code_line_ids" invisible="1">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="reference_code"/>
                            <field name="reference_type"/>
                            <field name="active"/>
                            <field name="note"/>
                        </list>
                    </field>
                </div>
            </xpath>

            <!-- Codes 组里的原生 Reference 已移到标题区，隐藏避免重复 -->
            <xpath expr="//group[@name='codes']/field[@name='default_code']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

        </field>
    </record>

    <!-- ============================================================ -->
    <!-- 变体主表单（product.product.form，继承模板基础视图）：        -->
    <!-- 同样在产品名称下方放置 Reference 编辑器；常规信息页分类栏里  -->
    <!-- 的原生 Reference 隐藏避免重复                                -->
    <!-- ============================================================ -->
    <record id="product_normal_form_view_inherit" model="ir.ui.view">
        <field name="name">product.product.form.inherit.reference.code</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//div[hasclass('oe_title')]/h1" position="after">
                <div name="product_reference" class="o_product_reference_area mt-1">
                    <!-- 标签固定为 Ref.（中文界面同样显示 Ref.，不做本地化翻译） -->
                    <label for="default_code" string="Ref."/>
                    <field name="default_code"
                           widget="product_reference_editor"
                           nolabel="1"
                           placeholder="e.g. REF-A, SKU-1234"/>
                    <field name="reference_code_line_ids" invisible="1">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="reference_code"/>
                            <field name="reference_type"/>
                            <field name="active"/>
                            <field name="note"/>
                        </list>
                    </field>
                </div>
            </xpath>

            <xpath expr="//group[@name='group_standard_price']/field[@name='default_code']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

        </field>
    </record>

</odoo>
