<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- 产品表单视图：移除「参考号」页，改在产品名称下方放置原生     -->
    <!-- Reference 输入框 + 「+」（额外参考号管理弹窗）+ 数量徽标      -->
    <!-- 继承基础视图 product.product_template_form_view，对其所有     -->
    <!-- primary 子视图（如 product_template_only_form_view）同步生效   -->
    <!-- ============================================================ -->
    <record id="product_template_form_inherit" model="ir.ui.view">
        <field name="name">product.template.form.inherit.reference.code</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">

            <!-- 产品名称下方：Reference 编辑器（原生 default_code + 额外参考号入口）。
                 多变体产品的参考号不共用（各变体维护自己的），故整块隐藏 -->
            <xpath expr="//div[hasclass('oe_title')]/h1" position="after">
                <div name="product_reference"
                     class="o_product_reference_area mt-1"
                     invisible="product_variant_count &gt; 1">
                    <!-- 标签固定为 Ref.（中文界面同样显示 Ref.，不做本地化翻译） -->
                    <label for="default_code" string="Ref."/>
                    <field name="default_code"
                           widget="product_reference_editor"
                           nolabel="1"
                           placeholder="e.g. REF-A, SKU-1234"/>
                    <!-- 额外参考号 One2many（不可见）：为 widget 提供子字段元数据，
                         新建参考号行时 activeFields 才含 reference_code 等字段 -->
                    <field name="reference_code_line_ids" invisible="1">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="reference_code"/>
                            <field name="reference_type"/>
                            <field name="active"/>
                            <field name="note"/>
                        </list>
                    </field>
                </div>
            </xpath>

        </field>
    </record>

    <!-- ============================================================ -->
    <!-- 原生「常规信息」页的 Reference 已移到标题区，此处隐藏避免重复 -->
    <!-- （product_template_only_form_view 在 categ_id 后放了原生字段） -->
    <!-- ============================================================ -->
    <record id="product_template_only_form_inherit" model="ir.ui.view">
        <field name="name">product.template.only.form.inherit.reference.code</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">

            <!-- 只隐藏「常规信息」页分类栏里的原生字段；标题区的编辑器在 oe_title 内，
                 用 group 限定避免 xpath 同时命中两处 default_code -->
            <xpath expr="//group[@name='group_standard_price']/field[@name='default_code']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

        </field>
    </record>

    <!-- ============================================================ -->
    <!-- 产品列表视图：新增「参考号」列（可选显示）                   -->
    <!-- ============================================================ -->
    <record id="product_template_list_inherit" model="ir.ui.view">
        <field name="name">product.template.list.inherit.reference.code</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='default_code']" position="after">
                <field name="reference_code_index" string="Reference"
                       optional="show"
                       widget="text"
                       readonly="1"/>
            </xpath>

        </field>
    </record>

    <!-- ============================================================ -->
    <!-- 搜索视图：顶部搜索框并入参考号搜索；新增「参考号」独立搜索项  -->
    <!-- ============================================================ -->
    <record id="product_template_search_inherit" model="ir.ui.view">
        <field name="name">product.template.search.inherit.reference.code</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">

            <!-- 顶部搜索框：在原生 default_code/变体/barcode 之外并入参考号。
                 变体参考号不写回 reference_code_index（多变体不共用），
                 因此额外并入 product_variant_ids.variant_reference_code_index，
                 保证在变体里加的参考号也能在产品列表搜到 -->
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="filter_domain">[
                    '|', '|', '|', '|', '|',
                    ('default_code', 'ilike', self),
                    ('product_variant_ids.default_code', 'ilike', self),
                    ('name', 'ilike', self),
                    ('barcode', 'ilike', self),
                    ('reference_code_index', 'ilike', self),
                    ('product_variant_ids.variant_reference_code_index', 'ilike', self)
                ]</attribute>
            </xpath>

            <!-- 独立的「参考号」搜索项，便于精确过滤（同样含变体参考号） -->
            <xpath expr="//field[@name='name']" position="after">
                <field name="reference_code_index" string="Reference"
                       filter_domain="[
                           '|',
                           ('reference_code_index', 'ilike', self),
                           ('product_variant_ids.variant_reference_code_index', 'ilike', self)
                       ]"/>
            </xpath>

        </field>
    </record>

</odoo>
