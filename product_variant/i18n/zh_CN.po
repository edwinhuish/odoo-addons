#. module: product_variant
#: model:ir.model.fields,field_description:product_variant.field_product_product__variant_conversion_count
#: model:ir.model.fields,field_description:product_variant.field_product_template__variant_conversion_count
msgid "# Variant Conversions"
msgstr "转换次数"

#. module: product_variant
#. odoo-javascript
#: code:addons/product_variant/static/src/js/variant_mapping_panel.js:0
msgid "%(count)s combinations are not created now: they only sit on attributes that create their variants on demand, and no existing variant keeps them yet — Odoo creates those variants when they are ordered. Assign a variant here to create one right away."
msgstr "有 %(count)s 个组合现在不会创建：它们落在「按需生成变体」的属性上，而且还没有任何既有变体认领 —— 这些变体由 Odoo 在订单里创建。在这里给它分配一条变体即可立即创建。"

#. module: product_variant
#. odoo-javascript
#: code:addons/product_variant/static/src/js/variant_mapping_panel.js:0
msgid "Already kept by another combination — set that one back to (new variant) first if you want to move it here"
msgstr "已被另一个组合占用 —— 想挪到这一行，请先把占着它的那一行改回「(new variant)」"

#. module: product_variant
#. odoo-javascript
#: code:addons/product_variant/static/src/js/variant_mapping_panel.js:0
msgid "%(count)s combinations have no existing variant and will be created as new variants"
msgstr "还有 %(count)s 个组合没有既有变体认领，将作为新变体创建"

#. module: product_variant
#. odoo-javascript
#: code:addons/product_variant/static/src/js/variant_mapping_panel.js:0
msgid ""
"%(count)s variants are mapped to the same combination: a combination can only be kept by "
"one variant. Change the values so that each variant has its own combination."
msgstr ""
"有 %(count)s 条变体被映射到了同一个组合：每个组合只能由一条变体保留。"
"请调整取值，让每条变体都有自己的组合。"

#. module: product_variant
#. odoo-javascript
#: code:addons/product_variant/static/src/js/variant_mapping_panel.js:0
msgid "%(count)s existing variants are not assigned to any combination yet: assign each of them in the Variant column (the combination itself is never dropped, it would just create a new variant)."
msgstr "还有 %(count)s 条既有变体没有被分配到任何组合：请在 Variant 列里逐条指定（组合本身不会丢，没人认领的组合就新建一条变体）。"

#. module: product_variant
#. odoo-javascript
#: code:addons/product_variant/static/src/js/variant_mapping_panel.js:0
msgid "%(count)s variants have not been assigned to a combination yet: pick each of them in the Variant column of the mapping table below the attribute lines, then save again."
msgstr "还有 %(count)s 条变体没有被分配到组合：请在属性行下方映射表的 Variant 列里逐条指定，然后再保存。"

#. module: product_variant
#. odoo-javascript
#: code:addons/product_variant/static/src/js/variant_mapping_panel.js:0
msgid "%(label)s — %(count)s on hand"
msgstr "%(label)s — 在手 %(count)s"

#. module: product_variant
#. odoo-python
#: code:addons/product_variant/models/product_template.py:0
msgid "A combo product cannot be converted into a multi-variant product."
msgstr "组合产品不能转换为多变体产品。"

#. module: product_variant
#. odoo-python
#: code:addons/product_variant/models/product_template.py:0
msgid "Add at least one attribute before converting the product."
msgstr "转换前请至少添加一个属性。"

#. module: product_variant
#: model:ir.model.fields,field_description:product_variant.field_product_variant_conversion__added_attribute_ids
msgid "Added Attributes"
msgstr "新增属性"

#. module: product_variant
#. odoo-javascript
#: code:addons/product_variant/static/src/js/variant_mapping_panel.js:0
msgid "Apply the vendor prices of these variants to all variants"
msgstr "把这些变体的供应商价格应用到全部变体"

#. module: product_variant
#. odoo-python
#: code:addons/product_variant/models/product_template.py:0
msgid ""
"Attribute %(attribute)s is configured twice on the product; keep a single "
"attribute line before converting."
msgstr "产品上属性 %(attribute)s 配置了两行，请先合并为一行再转换。"

#. module: product_variant
#. odoo-python
#: code:addons/product_variant/models/product_template.py:0
msgid ""
"Attribute %(attribute)s is used twice; keep a single line per attribute."
msgstr "属性 %(attribute)s 重复出现，每个属性只能有一行。"

#. module: product_variant
#. odoo-python
#: code:addons/product_variant/models/product_template.py:0
msgid "Attribute %(attribute)s needs at least one value."
msgstr "属性 %(attribute)s 至少需要一个取值。"

#. module: product_variant
#. odoo-python
#: code:addons/product_variant/models/product_template.py:0
msgid ""
"Attribute %(attribute)s never creates variants, so it cannot be used to "
"convert the product."
msgstr "属性 %(attribute)s 设置为不生成变体，无法用于转换产品。"

#. module: product_variant
#. odoo-javascript
#: code:addons/product_variant/static/src/js/variant_mapping_panel.js:0
#: model:ir.model.fields,field_description:product_variant.field_product_product__variant_mapping_state
#: model:ir.model.fields,field_description:product_variant.field_product_template__variant_mapping_state
msgid "Attribute / Variant Mapping"
msgstr "属性 / 变体映射"

#. module: product_variant
#: model:ir.model,name:product_variant.model_product_attribute_value
msgid "Attribute Value"
msgstr "属性值"

#. module: product_variant
#: model:ir.model.fields,help:product_variant.field_product_variant_lineage__origin_summary
msgid "Attribute values of the original variant before the conversion."
msgstr "原变体在转换前的属性取值。"

#. module: product_variant
#: model:ir.model.fields,help:product_variant.field_product_variant_lineage__result_summary
msgid "Attribute values of the resulting variant after the conversion."
msgstr "结果变体在转换后的属性取值。"

#. module: product_variant
#: model:ir.model.fields,help:product_variant.field_product_variant_conversion__added_attribute_ids
msgid ""
"Attributes that were not configured on the product before this conversion."
msgstr "本次转换之前产品上没有配置的属性。"

#. module: product_variant
#: model:ir.model.fields,field_description:product_variant.field_product_variant_lineage__result_barcode
msgid "Barcode (After)"
msgstr "条码（转换后）"

#. module: product_variant
#: model:ir.model.fields,help:product_variant.field_product_variant_lineage__result_barcode
msgid ""
"Barcode of the resulting variant. It belongs to the variant: the conversion "
"never changes it."
msgstr "结果变体的条码。条码属于变体本身，转换不会改动它。"

#. module: product_variant
#. odoo-python
#: code:addons/product_variant/models/product_template.py:0
msgid ""
"Changing the attributes of several products at once cannot keep track of the"
" variant ownership of %(product)s. Save the products one by one from the "
"product form."
msgstr "一次改多个产品的属性没法逐条记录变体归属（%(product)s）。请逐个产品在产品表单里保存。"

#. module: product_variant
#: model:ir.model.fields,field_description:product_variant.field_product_variant_lineage__result_summary
msgid "Combination After"
msgstr "转换后的组合"

#. module: product_variant
#: model:ir.model.fields,field_description:product_variant.field_product_variant_lineage__origin_summary
msgid "Combination Before"
msgstr "转换前的组合"

#. module: product_variant
#: model:ir.model.fields,field_description:product_variant.field_product_variant_lineage__conversion_id
msgid "Conversion"
msgstr "所属转换"

#. module: product_variant
#: model:ir.model.fields,help:product_variant.field_product_product__variant_conversion_id
msgid ""
"Conversion that added attributes to this product. Set on the variants that "
"existed before the conversion and on the variants it created."
msgstr "给本产品增加属性的那次转换。转换前既有的变体与本次新建的变体上都会记录。"

#. module: product_variant
#: model_terms:ir.ui.view,arch_db:product_variant.product_template_only_form_inherit_variant_conversion
msgid "Conversions"
msgstr "转换记录"

#. module: product_variant
#: model:ir.model.fields,help:product_variant.field_product_product__variant_conversion_ids
#: model:ir.model.fields,help:product_variant.field_product_template__variant_conversion_ids
msgid "Conversions that added attributes to this product."
msgstr "给本产品增加过属性的转换记录。"

#. module: product_variant
#: model_terms:ir.ui.view,arch_db:product_variant.product_variant_conversion_view_form
#: model_terms:ir.ui.view,arch_db:product_variant.product_variant_conversion_view_list
msgid "Converted By"
msgstr "转换人"

#. module: product_variant
#: model_terms:ir.ui.view,arch_db:product_variant.product_variant_conversion_view_form
#: model_terms:ir.ui.view,arch_db:product_variant.product_variant_conversion_view_list
msgid "Converted On"
msgstr "转换时间"

#. module: product_variant
#: model:ir.model.fields,field_description:product_variant.field_product_variant_lineage__result_standard_price
msgid "Cost (After)"
msgstr "成本（转换后）"

#. module: product_variant
#: model:ir.model.fields,help:product_variant.field_product_variant_lineage__result_standard_price
msgid ""
"Cost of the resulting variant. It belongs to the variant: the conversion "
"never changes it."
msgstr "结果变体的成本。成本属于变体本身，转换不会改动它。"

#. module: product_variant
#: model_terms:ir.ui.view,arch_db:product_variant.product_search_form_inherit_variant_lineage
msgid "Created By A Conversion"
msgstr "由转换产生"

#. module: product_variant
#: model:ir.model.fields,field_description:product_variant.field_product_variant_conversion__create_uid
#: model:ir.model.fields,field_description:product_variant.field_product_variant_lineage__create_uid
msgid "Created by"
msgstr ""

#. module: product_variant
#: model:ir.model.fields,field_description:product_variant.field_product_variant_conversion__create_date
#: model:ir.model.fields,field_description:product_variant.field_product_variant_lineage__create_date
msgid "Created on"
msgstr ""

#. module: product_variant
#: model:ir.model.fields,field_description:product_variant.field_product_product__variant_origin_id
#: model_terms:ir.ui.view,arch_db:product_variant.product_search_form_inherit_variant_lineage
msgid "Derived From"
msgstr "来源变体"

#. module: product_variant
#: model:ir.model.fields,field_description:product_variant.field_product_attribute_value__display_name
#: model:ir.model.fields,field_description:product_variant.field_product_product__display_name
#: model:ir.model.fields,field_description:product_variant.field_product_template__display_name
#: model:ir.model.fields,field_description:product_variant.field_product_template_attribute_line__display_name
#: model:ir.model.fields,field_description:product_variant.field_product_template_attribute_value__display_name
#: model:ir.model.fields,field_description:product_variant.field_product_variant_conversion__display_name
#: model:ir.model.fields,field_description:product_variant.field_product_variant_lineage__display_name
msgid "Display Name"
msgstr ""

#. module: product_variant
#: model_terms:ir.actions.act_window,help:product_variant.product_variant_conversion_action
msgid ""
"Every conversion is recorded when attributes are added to a product from its"
" own form."
msgstr "每次从产品表单给产品增加属性时都会留下转换记录。"

#. module: product_variant
#. odoo-javascript
#: code:addons/product_variant/static/src/js/variant_mapping_panel.js:0
msgid "Every combination that will exist, and which existing variant keeps it. Leave the variant empty to create a new one; a variant that is not assigned to any combination would be dropped, so the save is blocked until each of them is assigned."
msgstr "这次改动之后会存在的每个组合，以及由哪条既有变体继续保留它。变体留空 = 这个组合新建一条变体；没被分配到任何组合的既有变体会被丢弃，所以在每条既有变体都分配好之前，保存会被拦住。"

#. module: product_variant
#. odoo-python
#: code:addons/product_variant/models/product_template.py:0
msgid ""
"Every existing variant must keep a combination: %(variants)s has no "
"combination. Save the product form again to get the ownership dialog."
msgstr "每条既有变体都必须保留一个组合：%(variants)s 还没有组合。请在产品表单里再保存一次以弹出归属确认框。"

#. module: product_variant
#: model:ir.model.fields,field_description:product_variant.field_product_attribute_value__id
#: model:ir.model.fields,field_description:product_variant.field_product_product__id
#: model:ir.model.fields,field_description:product_variant.field_product_template__id
#: model:ir.model.fields,field_description:product_variant.field_product_template_attribute_line__id
#: model:ir.model.fields,field_description:product_variant.field_product_template_attribute_value__id
#: model:ir.model.fields,field_description:product_variant.field_product_variant_conversion__id
#: model:ir.model.fields,field_description:product_variant.field_product_variant_lineage__id
msgid "ID"
msgstr ""

#. module: product_variant
#: model:ir.model.fields,help:product_variant.field_product_variant_lineage__result_default_code
msgid ""
"Internal reference of the resulting variant. It belongs to the variant: the "
"conversion never changes it."
msgstr "结果变体的内部参考号。参考号属于变体本身，转换不会改动它。"

#. module: product_variant
#: model:ir.model.fields,field_description:product_variant.field_product_variant_conversion__write_uid
#: model:ir.model.fields,field_description:product_variant.field_product_variant_lineage__write_uid
msgid "Last Updated by"
msgstr ""

#. module: product_variant
#: model:ir.model.fields,field_description:product_variant.field_product_variant_conversion__write_date
#: model:ir.model.fields,field_description:product_variant.field_product_variant_lineage__write_date
msgid "Last Updated on"
msgstr ""

#. module: product_variant
#: model:ir.model.fields,field_description:product_variant.field_product_variant_conversion__new_variant_count
msgid "New Variants"
msgstr "新增变体数"

#. module: product_variant
#: model_terms:ir.actions.act_window,help:product_variant.product_variant_conversion_action
msgid "No variant conversion recorded yet"
msgstr "还没有转换记录"

#. module: product_variant
#: model:ir.model.fields,help:product_variant.field_product_product__variant_conversion_count
#: model:ir.model.fields,help:product_variant.field_product_template__variant_conversion_count
msgid "Number of conversions applied to this product."
msgstr "本产品经历的转换次数。"

#. module: product_variant
#: model:ir.model.fields,help:product_variant.field_product_variant_conversion__new_variant_count
msgid ""
"Number of variants created by the conversion; every variant that existed "
"before is kept as is."
msgstr "本次转换新建的变体数；转换前的每条变体都原样保留。"

#. module: product_variant
#: model:ir.model.fields,help:product_variant.field_product_variant_conversion__product_variant_count_before
msgid "Number of variants the product had before the conversion."
msgstr "转换前产品的变体数。"

#. module: product_variant
#: model:ir.model.fields,help:product_variant.field_product_variant_conversion__product_variant_count_after
msgid "Number of variants the product had once the conversion was applied."
msgstr "转换后产品的变体数。"

#. module: product_variant
#: model:ir.model.fields,help:product_variant.field_product_variant_conversion__lineage_ids
msgid ""
"One line per variant that took part in the conversion: which variant it was "
"before and which combination it carries now."
msgstr "每条参与转换的变体一行：转换前是哪条记录、转换后占哪个组合。"

#. module: product_variant
#. odoo-python
#: code:addons/product_variant/models/product_template.py:0
msgid ""
"One of the original variants of %(product)s disappeared during the "
"conversion; nothing has been changed."
msgstr "转换过程中 %(product)s 的某条原变体消失了，本次转换未做任何改动。"

#. module: product_variant
#: model:ir.model.fields,field_description:product_variant.field_product_variant_lineage__is_kept
msgid "Original Record Kept"
msgstr "原记录保留"

#. module: product_variant
#: model:ir.model.fields,field_description:product_variant.field_product_variant_lineage__origin_variant_id
msgid "Original Variant"
msgstr "原变体"

#. module: product_variant
#: model:ir.model.fields,help:product_variant.field_product_product__variant_origin_id
msgid ""
"Original variant this variant was created from during a conversion: the "
"record that kept the stock, the orders and the invoices. Empty for the "
"variants that existed before the conversion (they are the origins "
"themselves) and for manually created ones."
msgstr "该变体在转换中派生自哪条原变体，也就是当时保留库存、订单与发票的那条记录。转换前就存在的变体（它们本身就是来源）与手工新建的变体上为空。"

#. module: product_variant
#: model:ir.model,name:product_variant.model_product_template_attribute_line
msgid "Product Template Attribute Line"
msgstr "产品模板属性行"

#. module: product_variant
#: model:ir.model,name:product_variant.model_product_template_attribute_value
msgid "Product Template Attribute Value"
msgstr "产品模板属性值"

#. module: product_variant
#: model:ir.model,name:product_variant.model_product_product
msgid "Product Variant"
msgstr "产品变体"

#. module: product_variant
#: model:ir.model,name:product_variant.model_product_variant_lineage
msgid "Product Variant Lineage"
msgstr "产品变体谱系"

#. module: product_variant
#: model:ir.model.fields,field_description:product_variant.field_product_variant_lineage__result_default_code
msgid "Reference (After)"
msgstr "内部参考号（转换后）"

#. module: product_variant
#. odoo-python
#: code:addons/product_variant/models/product_attribute_guards.py:0
msgid ""
"Removing the attribute %(attribute)s from %(product)s would affect %(count)s"
" active variants, for example %(variant)s: they carry its values and keep "
"the stock, the orders and the invoices. Archive or delete those variants "
"first, then remove the attribute."
msgstr "从 %(product)s 移除属性 %(attribute)s 会影响 %(count)s 个在用变体（例如 %(variant)s）：它们携带该属性的取值，并保存着库存、订单与发票。请先归档或删除这些变体，再移除该属性。"

#. module: product_variant
#. odoo-python
#: code:addons/product_variant/models/product_attribute_guards.py:0
msgid ""
"Removing the value %(value)s of %(attribute)s from %(product)s would affect "
"%(count)s active variants: they carry it and keep the stock, the orders and "
"the invoices. Archive or delete those variants first, then remove the value."
msgstr "从 %(product)s 移除属性 %(attribute)s 的取值 %(value)s 会影响 %(count)s 个在用变体：它们携带该取值，并保存着库存、订单与发票。请先归档或删除这些变体，再移除该取值。"

#. module: product_variant
#: model:ir.model.fields,field_description:product_variant.field_product_variant_lineage__result_variant_id
msgid "Resulting Variant"
msgstr "结果变体"

#. module: product_variant
#: model:ir.model.fields,help:product_variant.field_product_variant_lineage__is_kept
msgid ""
"Set when the resulting variant is the very same product variant record as "
"the original one: no record was created nor deleted for this combination."
msgstr "当结果变体就是原来那条变体记录时置位：这个组合没有新建也没有删除任何记录。"

#. module: product_variant
#. odoo-python
#: code:addons/product_variant/models/product_variant_mapping.py:0
msgid ""
"Some variants of %(product)s have no combination after this attribute "
"change: pick the combination each of them keeps in the mapping table below "
"the attribute lines, then save again."
msgstr "这次属性改动之后，%(product)s 有变体没有组合：请在属性行下方的映射表里给每条变体指定它保留的组合，然后再保存。"

#. module: product_variant
#. odoo-python
#: code:addons/product_variant/models/product_template_prices.py:0
msgid ""
"Spreading the price data of %(product)s over its variants would change the "
"prices available on %(variant)s; nothing has been changed."
msgstr "把 %(product)s 的价格数据拆到各变体后，%(variant)s 上可用的价格会发生变化；未做任何改动。"

#. module: product_variant
#. odoo-python
#: code:addons/product_variant/models/product_template_prices.py:0
msgid ""
"Spreading the price data of %(product)s over its variants would lose vendor "
"prices on %(variant)s; nothing has been changed."
msgstr "把 %(product)s 的价格数据拆到各变体会丢失 %(variant)s 上的供应商价格；未做任何改动。"

#. module: product_variant
#. odoo-javascript
#: code:addons/product_variant/static/src/xml/variant_mapping_panel.xml:0
msgid "Status"
msgstr "状态"

#. module: product_variant
#: model:ir.model.fields,help:product_variant.field_product_product__variant_mapping_state
#: model:ir.model.fields,help:product_variant.field_product_template__variant_mapping_state
msgid ""
"Technical mount point for the mapping table shown under the attribute lines "
"of the product form: the table asks get_variant_mapping_preview() for its "
"content when it mounts, this field itself carries no value. It is "
"deliberately NOT a computed field: a compute runs inside every onchange, "
"with the unsaved rows of the form around, and would try to serialize their "
"NewId (see AGENTS.md, L2 P4 trap 12)."
msgstr ""
"产品表单属性行下方那张映射表的技术挂载点：映射表在挂载时自己调 get_variant_mapping_preview() "
"取内容，这个字段本身不带值。它**故意不做 compute** —— compute 会在每次 onchange 里被求值，那时表单里还有没保存的行（带 "
"NewId），序列化会抛 TypeError（见 AGENTS.md，L2 P4 陷阱 12）。"

#. module: product_variant
#: model:ir.model.fields,help:product_variant.field_product_product__variant_conversion_mapping
#: model:ir.model.fields,help:product_variant.field_product_template__variant_conversion_mapping
msgid ""
"Technical field used by the product form. When an attribute change creates "
"new variants, the form asks for the variant ownership and sends it here, "
"together with the attribute change itself. It is cleared as soon as the "
"conversion has been applied."
msgstr "产品表单使用的技术字段：属性变更会新增变体时，表单先问归属映射、再把归属与属性变更一起提交到这里；转换应用完即刻清空。"

#. module: product_variant
#. odoo-python
#: code:addons/product_variant/models/product_template.py:0
msgid ""
"The attribute %(attributes)s of %(product)s creates its variants on demand: "
"Odoo itself creates those variants from the orders, so a product saved with "
"such an attribute gets no variant at all (the first one is created the first"
" time it is ordered). Create the product without that attribute and add it "
"to the product afterwards — the conversion then keeps the existing variants "
"— or set its Variant Creation to Instantly before saving."
msgstr ""
"属性 %(attributes)s 的变体生成方式是「按需生成」：这类变体由 Odoo 按订单创建，"
"所以建产品时带上它会一条变体都没有（第一次下单时才创建第一条）。"
