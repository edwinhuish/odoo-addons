<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!--
        「属性 ↔ 变体」映射表（产品表单「属性与变体」页、属性行下方）。

        每个**属性组合**一行（属性列全部只读：取值由属性行穷举出来，用户不在这里改属性），
        行里的 **Variant** 下拉指定「这个组合由哪条既有变体继续保留」：
        留空 = 新建变体；选一条 = 那条变体接着承载这个组合。
        同一条变体只能承载一个组合，所以已经被别的行选走的变体在那一行的下拉里是**禁用**的：
        要换位置，先把占着它的那一行改回「(new variant)」把它让出来，再给另一行选。
        没被任何组合选走的既有变体会在上方点名并拦住保存。

        所有说明性文案都在 JS 侧用 _t() 拼好（见模块 AGENTS.md → L2 P2 陷阱 2），
        模板只负责渲染，不写句子。
    -->
    <t t-name="product_variant.VariantMappingPanel">
        <!-- 新建（还没保存）的产品没有既有变体可映射；换记录后快照还没取回来时先整块藏起来，
             免得把上一条产品的映射当成这一条的（见 AGENTS.md → L2 P4 陷阱 24） -->
        <div t-if="showPanel" class="o_variant_mapping_panel mt-3 w-100">
            <h5 class="o_variant_mapping_title border-bottom pb-1 mb-2" t-esc="panelTitle"/>
            <div class="text-muted" t-esc="introLabel"/>
            <div t-if="unassignedCount" class="alert alert-warning mt-2 mb-1" t-esc="unassignedHint"/>
            <div t-if="unassignedCount" class="text-muted small" t-esc="unassignedLabel"/>

            <table t-if="store.rows.length" class="table table-sm align-middle mt-2">
                <thead>
                    <tr>
                        <th t-foreach="axisLabels" t-as="label" t-key="label_index" t-esc="label"/>
                        <th>Variant</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="store.rows" t-as="row" t-key="row.key"
                        t-att-class="(row.is_new ? 'table-warning ' : '') + (row.will_create ? '' : 'text-muted')">
                        <td t-foreach="row.cells" t-as="cell" t-key="cell.attribute_id"
                            t-esc="cell.value_name"/>
                        <td>
                            <select class="form-select"
                                    t-att-disabled="!isEditable"
                                    t-on-change="(ev) => this.onSelectVariant(row, ev)">
                                <option value="" t-att-selected="!row.variant_id" t-esc="newVariantLabel"/>
                                <option t-foreach="variantOptions" t-as="option" t-key="option.id"
                                        t-att-value="option.id"
                                        t-att-selected="row.variant_id === option.id"
                                        t-att-disabled="isOptionTaken(option, row)"
                                        t-att-title="isOptionTaken(option, row) ? takenElsewhereLabel : ''"
                                        t-esc="option.label"/>
                            </select>
                        </td>
                    </tr>
                </tbody>
            </table>

            <div t-if="store.newCount" class="text-muted mt-2" t-esc="newVariantsLabel"/>
            <div t-if="pendingCount" class="text-muted mt-2" t-esc="pendingHint"/>
            <div class="o_variant_mapping_actions form-check mt-3">
                <input class="form-check-input" type="checkbox" id="variant_mapping_share_vendor_prices"
                       t-att-checked="store.shareVendorPrices"
                       t-att-disabled="!isEditable"
                       t-on-change="onToggleShareVendorPrices"/>
                <label class="form-check-label" for="variant_mapping_share_vendor_prices"
                       t-esc="shareVendorPricesLabel"/>
            </div>

            <!-- 映射改过（尚未保存）时**只留提示**，不放按钮：保存 / 丢弃一律用标题右侧
                 （导航栏下方）那两个原生按钮，它们由 ``FIELD_IS_DIRTY`` 广播点亮
                 （见模块 AGENTS.md → L2 P4 陷阱 20 / 21） -->
            <div t-if="mappingDirty" class="o_variant_mapping_unsaved d-flex align-items-center gap-2 mt-2">
                <span class="badge text-bg-warning" t-esc="unsavedLabel"/>
            </div>
            <div t-if="mappingDirty" class="text-muted small mt-1" t-esc="dirtyHint"/>
        </div>
    </t>

</templates>
