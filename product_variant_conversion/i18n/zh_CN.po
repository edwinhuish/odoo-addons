msgstr "转换次数"

#. module: product_variant_conversion
#. odoo-javascript
#: code:addons/product_variant_conversion/static/src/js/variant_conversion_dialog.js:0
msgid "%(count)s existing variants still have no combination"
msgstr "还有 %(count)s 条既有变体没有指定组合"

#. module: product_variant_conversion
#. odoo-python
#: code:addons/product_variant_conversion/models/product_template.py:0
msgid "A combo product cannot be converted into a multi-variant product."
msgstr "组合产品不能转换为多变体产品。"

#. module: product_variant_conversion
#. odoo-python
#: code:addons/product_variant_conversion/models/product_template.py:0
msgid "Add at least one attribute before converting the product."
msgstr "转换前请至少添加一个属性。"

#. module: product_variant_conversion
#: model:ir.model.fields,field_description:product_variant_conversion.field_product_variant_conversion__added_attribute_ids
msgid "Added Attributes"
msgstr "新增属性"

#. module: product_variant_conversion
#. odoo-javascript
#: code:addons/product_variant_conversion/static/src/js/variant_conversion_dialog.js:0
msgid "Apply the vendor prices of these variants to all variants"
msgstr "把这些变体的供应商价格应用到全部变体"

#. module: product_variant_conversion
#. odoo-python
#: code:addons/product_variant_conversion/models/product_template.py:0
msgid ""
"Attribute %(attribute)s creates variants on demand; set its variant creation"
" mode to instantly before converting the product."
msgstr "属性 %(attribute)s 设置为按需生成变体，请先把它的变体生成方式改为「立即」再转换产品。"

#. module: product_variant_conversion
#. odoo-python
#: code:addons/product_variant_conversion/models/product_template.py:0
msgid ""
"Attribute %(attribute)s is configured twice on the product; keep a single "
"attribute line before converting."
msgstr "产品上属性 %(attribute)s 配置了两行，请先合并为一行再转换。"

#. module: product_variant_conversion
#. odoo-python
#: code:addons/product_variant_conversion/models/product_template.py:0
msgid ""
"Attribute %(attribute)s is used twice; keep a single line per attribute."
msgstr "属性 %(attribute)s 重复出现，每个属性只能有一行。"

#. module: product_variant_conversion
#. odoo-python
#: code:addons/product_variant_conversion/models/product_template.py:0
msgid "Attribute %(attribute)s needs at least one value."
msgstr "属性 %(attribute)s 至少需要一个取值。"

#. module: product_variant_conversion
#. odoo-python
#: code:addons/product_variant_conversion/models/product_template.py:0
msgid ""
"Attribute %(attribute)s never creates variants, so it cannot be used to "
"convert the product."
msgstr "属性 %(attribute)s 设置为不生成变体，无法用于转换产品。"

#. module: product_variant_conversion
#: model:ir.model.fields,help:product_variant_conversion.field_product_variant_lineage__origin_summary
msgid "Attribute values of the original variant before the conversion."
msgstr "原变体在转换前的属性取值。"

#. module: product_variant_conversion
#: model:ir.model.fields,help:product_variant_conversion.field_product_variant_lineage__result_summary
msgid "Attribute values of the resulting variant after the conversion."
msgstr "结果变体在转换后的属性取值。"

#. module: product_variant_conversion
#: model:ir.model.fields,help:product_variant_conversion.field_product_variant_conversion__added_attribute_ids
msgid ""
"Attributes that were not configured on the product before this conversion."
msgstr "本次转换之前产品上没有配置的属性。"

#. module: product_variant_conversion
#. odoo-javascript
#: code:addons/product_variant_conversion/static/src/xml/variant_conversion_dialog.xml:0
msgid "Cancel"
msgstr "取消"

#. module: product_variant_conversion
#. odoo-python
#: code:addons/product_variant_conversion/models/product_template.py:0
msgid ""
"Changing the attributes of several products at once cannot keep track of the"
" variant ownership of %(product)s. Save the products one by one from the "
"product form."
msgstr "一次改多个产品的属性没法逐条记录变体归属（%(product)s）。请逐个产品在产品表单里保存。"

#. module: product_variant_conversion
#. odoo-javascript
#: code:addons/product_variant_conversion/static/src/xml/variant_conversion_dialog.xml:0
#: model:ir.model.fields,field_description:product_variant_conversion.field_product_variant_lineage__result_summary
msgid "Combination After"
msgstr "转换后的组合"

#. module: product_variant_conversion
#: model:ir.model.fields,field_description:product_variant_conversion.field_product_variant_lineage__origin_summary
msgid "Combination Before"
msgstr "转换前的组合"

#. module: product_variant_conversion
#. odoo-javascript
#: code:addons/product_variant_conversion/static/src/xml/variant_conversion_dialog.xml:0
msgid "Confirm"
msgstr "确认"

#. module: product_variant_conversion
#: model:ir.model.fields,field_description:product_variant_conversion.field_product_variant_lineage__conversion_id
msgid "Conversion"
msgstr "所属转换"

#. module: product_variant_conversion
#: model:ir.model.fields,help:product_variant_conversion.field_product_product__variant_conversion_id
msgid ""
"Conversion that added attributes to this product. Set on the variants that "
"existed before the conversion and on the variants it created."
msgstr "给本产品增加属性的那次转换。转换前既有的变体与本次新建的变体上都会记录。"

#. module: product_variant_conversion
#: model_terms:ir.ui.view,arch_db:product_variant_conversion.product_template_only_form_inherit_variant_conversion
msgid "Conversions"
msgstr "转换记录"

#. module: product_variant_conversion
#: model:ir.model.fields,help:product_variant_conversion.field_product_product__variant_conversion_ids
#: model:ir.model.fields,help:product_variant_conversion.field_product_template__variant_conversion_ids
msgid "Conversions that added attributes to this product."
msgstr "给本产品增加过属性的转换记录。"

#. module: product_variant_conversion
#: model_terms:ir.ui.view,arch_db:product_variant_conversion.product_variant_conversion_view_form
#: model_terms:ir.ui.view,arch_db:product_variant_conversion.product_variant_conversion_view_list
msgid "Converted By"
msgstr "转换人"

#. module: product_variant_conversion
#: model_terms:ir.ui.view,arch_db:product_variant_conversion.product_variant_conversion_view_form
