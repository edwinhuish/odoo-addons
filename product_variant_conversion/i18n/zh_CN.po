#: model:ir.model.fields,field_description:product_variant_conversion.field_product_product__variant_origin_id
#: model_terms:ir.ui.view,arch_db:product_variant_conversion.product_search_form_inherit_variant_lineage
msgid "Derived From"
msgstr "来源变体"

#. module: product_variant_conversion
#: model:ir.model.fields,field_description:product_variant_conversion.field_product_product__display_name
#: model:ir.model.fields,field_description:product_variant_conversion.field_product_template__display_name
#: model:ir.model.fields,field_description:product_variant_conversion.field_product_variant_conversion__display_name
