msgstr "转换时间"

#. module: product_variant_conversion
#: model_terms:ir.ui.view,arch_db:product_variant_conversion.product_search_form_inherit_variant_lineage
msgid "Created By A Conversion"
msgstr "由转换产生"

#. module: product_variant_conversion
#: model:ir.model.fields,field_description:product_variant_conversion.field_product_variant_conversion__create_uid
#: model:ir.model.fields,field_description:product_variant_conversion.field_product_variant_lineage__create_uid
