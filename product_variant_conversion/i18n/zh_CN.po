msgid "ID"
msgstr ""

#. module: product_variant_conversion
#. odoo-javascript
#: code:addons/product_variant_conversion/static/src/xml/variant_conversion_dialog.xml:0
msgid "Kept By"
msgstr "由谁继续承载"

#. module: product_variant_conversion
#: model:ir.model.fields,field_description:product_variant_conversion.field_product_variant_conversion__write_uid
#: model:ir.model.fields,field_description:product_variant_conversion.field_product_variant_lineage__write_uid
