#. module: product_variant_conversion
#: model_terms:ir.actions.act_window,help:product_variant_conversion.product_variant_conversion_action
msgid ""
"Every conversion is recorded when attributes are added to a product from its"
" own form."
msgstr "每次从产品表单给产品增加属性时都会留下转换记录。"

#. module: product_variant_conversion
#. odoo-python
#: code:addons/product_variant_conversion/models/product_template.py:0
msgid ""
"Every existing variant must keep a combination: %(variants)s has no "
"combination. Save the product form again to get the ownership dialog."
msgstr "每条既有变体都必须保留一个组合：%(variants)s 还没有组合。请在产品表单里再保存一次以弹出归属确认框。"

#. module: product_variant_conversion
#: model:ir.model.fields,field_description:product_variant_conversion.field_product_product__id
#: model:ir.model.fields,field_description:product_variant_conversion.field_product_template__id
