<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- 产品表单：不再加「添加属性与变体」按钮 —— 用户在原生「属性与变体」页 -->
    <!-- 照常改属性、点保存，保存时由前端钩子（static/src/js/form_patch）先问 -->
    <!-- 服务端这次改动的影响，需要时弹窗确认归属，未确认不保存。            -->
    <!-- 这里只补：技术字段（承载弹窗确认后的归属映射）、转换台账智能按钮。  -->
    <!-- 谱系明细在台账详情页里看（Conversions 智能按钮），不占产品表单一页， -->
    <!-- 免得产品详情页多出一个多数时候用不上的页签。                        -->
    <!-- 继承 product_template_only_form_view：该页由它添加，官方          -->
    <!-- sale / purchase / stock 等模块也都继承它，所以所有产品表单都生效   -->
    <!-- ============================================================ -->
    <record id="product_template_only_form_inherit_variant_conversion" model="ir.ui.view">
        <field name="name">product.template.only.form.inherit.variant.conversion</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">

            <!-- 保存时由前端填写的归属映射（JSON），服务端写完即清空 -->
            <!-- force_save：Record._getChanges() 会把「只读且未标 forceSave」的字段从
                 changes 里剔除，标上它才能保证这个字段一定随保存提交（见模块 AGENTS.md → L2 P4） -->
            <xpath expr="//page[@name='variants']/field[@name='attribute_line_ids']" position="before">
                <field name="variant_conversion_mapping" invisible="1" force_save="1"/>
            </xpath>

            <xpath expr="//button[@name='action_open_documents']" position="before">
                <button name="action_open_variant_conversions"
                        type="object"
                        icon="fa-sitemap"
                        class="oe_stat_button"
                        invisible="not variant_conversion_count">
                    <field string="Conversions" name="variant_conversion_count" widget="statinfo"/>
                </button>
            </xpath>

        </field>
    </record>

    <!-- ============================================================ -->
    <!-- 产品搜索：筛选「有派生变体（由转换产生）的产品」，便于按来源追溯 -->
    <!-- ============================================================ -->
    <record id="product_template_search_inherit_variant_lineage" model="ir.ui.view">
        <field name="name">product.template.search.inherit.variant.lineage</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='filter_to_sell']" position="after">
                <filter name="filter_variant_lineage" string="With Converted Variants"
                        domain="[('product_variant_ids.variant_origin_id', '!=', False)]"/>
            </xpath>
        </field>
    </record>

</odoo>
