<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- 报价单 / 销售订单 / 形式发票打印报表：用订单编号替代系统编号   -->
    <!-- Odoo 19 只有 report_saleorder_document 一个单据模板，          -->
    <!-- 报价单与形式发票均由它派生，改一处即可全覆盖。                 -->
    <!-- ============================================================ -->
    <template id="report_saleorder_document_inherit"
              inherit_id="sale.report_saleorder_document"
              priority="99">

        <xpath expr="//span[@t-field='doc.name']" position="replace">
            <!-- 优先显示订单编号，未分配时回退到系统编号 -->
            <span t-if="doc.order_no" t-field="doc.order_no"/>
            <span t-else="" t-field="doc.name"/>
        </xpath>

    </template>

    <!-- ============================================================ -->
    <!-- PDF 文件名：用 <function> 在加载阶段直接调 write 强制覆盖   -->
    <!-- sale.action_report_saleorder 与 sale.action_report_pro_forma_  -->
    <!-- invoice 的 print_report_name。                                -->
    <!-- 用 <function> 而非 <record id="sale.xxx"> 的原因：            -->
    <!-- 1. 跨模块引用 record id 存在解析不确定性（Odoo 19 数据加载器  -->
    <!--    对 update 模式下带模块前缀 id 的处理不统一）              -->
    <!-- 2. <function> 在 init/update/demo 三种模式下都会执行，        -->
    <!--    确保数据库里 print_report_name 必定为最新版本              -->
    <!-- 3. 用 env['ir.actions.report'].write 强制写入，绕过任何        -->
    <!--    noupdate 检查或缓存问题                                    -->
    <!-- 未分配编号时回退到 object.name，保证新建未保存单据不报错。    -->
    <!-- ============================================================ -->
    <function model="ir.actions.report" name="write">
        <value model="ir.actions.report" eval="[ref('sale.action_report_saleorder')]"/>
        <value eval="{'print_report_name': &quot;(object.state in ('draft', 'sent') and 'Quotation - %s' % (object.order_no or object.name)) or 'Order - %s' % (object.order_no or object.name)&quot;}"/>
    </function>

    <function model="ir.actions.report" name="write">
        <value model="ir.actions.report" eval="[ref('sale.action_report_pro_forma_invoice')]"/>
        <value eval="{'print_report_name': &quot;'PRO-FORMA - %s' % (object.order_no or object.name)&quot;}"/>
    </function>

</odoo>