<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- 报价单 / 销售订单 / 形式发票打印报表：用订单编号替代系统编号   -->
    <!-- Odoo 19 只有 report_saleorder_document 一个单据模板，          -->
    <!-- 报价单与形式发票均由它派生，改一处即可全覆盖。                 -->
    <!-- ============================================================ -->
    <template id="report_saleorder_document_inherit"
              inherit_id="sale.report_saleorder_document"
              priority="99">

        <xpath expr="//span[@t-field='doc.name']" position="replace">
            <!-- 优先显示订单编号，未分配时回退到系统编号 -->
            <span t-if="doc.order_no" t-field="doc.order_no"/>
            <span t-else="" t-field="doc.name"/>
        </xpath>

    </template>

    <!-- ============================================================ -->
    <!-- PDF 文件名：用订单编号替代系统编号                           -->
    <!-- 通过完整外部 ID（sale.xxx）引用 sale 模块的 ir.actions.report， -->
    <!-- Odoo 识别为更新现有记录而非新建。noupdate=1 防止升级时覆盖。  -->
    <!-- 未分配编号时回退到 object.name，保证新建未保存单据不报错。    -->
    <!-- ============================================================ -->
    <data noupdate="1">
        <record id="sale.action_report_saleorder" model="ir.actions.report">
            <field name="print_report_name">(object.state in ('draft', 'sent') and 'Quotation - %s' % (object.order_no or object.name)) or 'Order - %s' % (object.order_no or object.name)</field>
        </record>

        <record id="sale.action_report_saleorder_pro_forma" model="ir.actions.report">
            <field name="print_report_name">'PRO-FORMA - %s' % (object.order_no or object.name)</field>
        </record>
    </data>

</odoo>
