<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- 报价单 / 销售订单 / 形式发票打印报表：用订单编号替代系统编号   -->
    <!-- Odoo 19 只有 report_saleorder_document 一个单据模板，          -->
    <!-- 报价单与形式发票均由它派生，改一处即可全覆盖。                 -->
    <!-- ============================================================ -->
    <template id="report_saleorder_document_inherit"
              inherit_id="sale.report_saleorder_document"
              priority="99">

        <xpath expr="//span[@t-field='doc.name']" position="replace">
            <!-- 优先显示订单编号，未分配时回退到系统编号 -->
            <span t-if="doc.order_no" t-field="doc.order_no"/>
            <span t-else="" t-field="doc.name"/>
        </xpath>

    </template>

    <!-- ============================================================ -->
    <!-- PDF 文件名：用 <function> 调 _force_order_no_print_name      -->
    <!-- 强制按所有启用语言写入 print_report_name 翻译值。            -->
    <!--                                                            -->
    <!-- print_report_name 是 translate=True 字段（JSONB 多语言），    -->
    <!-- 普通 write({'print_report_name': '...'}) 只写当前 lang 对应   -->
    <!-- 的 key（XML 加载默认 en_US），其他语言（如 zh_CN）仍是旧值。 -->
    <!-- _force_order_no_print_name 在所有 res.lang 上写入相同值，     -->
    <!-- 确保任意语言下 PDF 文件名都用 order_no。                     -->
    <!-- 未分配编号时回退到 object.name，保证新建未保存单据不报错。    -->
    <!-- ============================================================ -->
    <function model="ir.actions.report" name="_force_order_no_print_name">
        <value model="ir.actions.report" eval="ref('sale.action_report_saleorder')"/>
        <value eval="&quot;(object.state in ('draft', 'sent') and 'Quotation - %s' % (object.order_no or object.name)) or 'Order - %s' % (object.order_no or object.name)&quot;"/>
    </function>

    <function model="ir.actions.report" name="_force_order_no_print_name">
        <value model="ir.actions.report" eval="ref('sale.action_report_pro_forma_invoice')"/>
        <value eval="&quot;'Proforma - %s' % (object.order_no or object.name)&quot;"/>
    </function>

    <!-- sale_pdf_quote_builder 模块新建的报表动作：report_name='sale.report_saleorder_raw' -->
    <!-- "打印 → 报价单/订单" 菜单项指向此动作（"打印 → PDF 询价" 指向 sale.action_report_saleorder） -->
    <function model="ir.actions.report" name="_force_order_no_print_name">
        <value model="ir.actions.report" eval="ref('sale_pdf_quote_builder.action_report_saleorder_raw')"/>
        <value eval="&quot;(object.state in ('draft', 'sent') and 'Quotation - %s' % (object.order_no or object.name)) or 'Order - %s' % (object.order_no or object.name)&quot;"/>
    </function>

</odoo>