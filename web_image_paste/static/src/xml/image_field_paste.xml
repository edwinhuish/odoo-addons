<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!--
        ImageField 根 div 绑定 paste / dragover / dragleave / drop 事件
        不替换原模板，只通过 t-inherit extension 模式添加事件处理器
        + 上传中进度条遮罩
    -->
    <t t-name="web_image_paste.ImageField" t-inherit="web.ImageField" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('opacity-trigger-hover')]" position="attributes">
            <attribute name="t-on-paste">onPaste</attribute>
            <attribute name="t-on-dragover.prevent">onDragOver</attribute>
            <attribute name="t-on-dragleave">onDragLeave</attribute>
            <attribute name="t-on-drop.prevent">onDrop</attribute>
            <attribute name="tabindex">0</attribute>
        </xpath>

        <!-- 上传中：img 用本地预览 data URL 即时渲染 -->
        <xpath expr="//img" position="attributes">
            <attribute name="t-att-src">state.isUploading and uploadingUrl or this.getUrl(props.previewImage or props.name)</attribute>
        </xpath>

        <!-- 上传中：在 img 之后追加进度条遮罩 -->
        <xpath expr="//img" position="after">
            <div t-if="state.isUploading" class="o_web_image_paste_progress position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center">
                <div class="o_web_image_paste_progress_inner text-center">
                    <div class="o_web_image_paste_spinner mx-auto mb-1"/>
                    <span class="small text-light">上传中…</span>
                </div>
            </div>
        </xpath>
    </t>

    <!--
        FileUploader 根 div 绑定 paste 事件，让所有使用 FileUploader 的场景
        （Many2many binary、附件上传等）都获得粘贴能力
    -->
    <t t-name="web_image_paste.FileUploader" t-inherit="web.FileUploader" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('d-contents')]" position="attributes">
            <attribute name="t-on-paste">onPaste</attribute>
        </xpath>
    </t>

</templates>
