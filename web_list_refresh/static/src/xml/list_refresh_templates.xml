<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!--
        只扩展控制面板，不重写核心模板：
        按钮插在分页器左侧；`env.viewRefresh` 缺失（表单等未注册的视图）时不渲染。
        点击走控制器注册进 sub-env 的处理器，不直接碰 model。
    -->
    <t t-name="web_list_refresh.ControlPanel" t-inherit="web.ControlPanel" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_cp_pager')]" position="before">
            <button t-if="env.viewRefresh"
                    type="button"
                    class="btn btn-secondary o_web_list_refresh_button"
                    t-on-click="() => env.viewRefresh.refresh()"
                    title="Refresh"
                    aria-label="Refresh">
                <i class="fa fa-refresh" role="img"/>
            </button>
        </xpath>
    </t>

</templates>
